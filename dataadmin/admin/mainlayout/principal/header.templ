package principal

import (
	"fmt"
	"github.com/templui/templui/components/dropdown"
	"github.com/templui/templui/components/icon"
	"github.com/templui/templui/components/sidebar"

	xm "github.com/dsaldias/server/graph_auth/model"
)

func nombreRolUnidad(roles []*xm.ResponseRolMe, unidadid string) string {
	for _, r := range roles {
		if r.Unidad != nil && r.Rol != nil && r.Unidad.ID == unidadid {
			return r.Unidad.Nombre
		}
	}

	return "Rol / Unidad"
}

templ Header(roles []*xm.ResponseRolMe, unidadid string) {
	<header class="sticky top-0 flex h-10 w-full shrink-0 items-center justify-between border-b px-6 bg-sidebar text-white z-[999]">
		<div class="flex items-center gap-3">
			@sidebar.Trigger(sidebar.TriggerProps{
				Class: "hover:bg-sidebar-accent",
			})
		</div>
		<div class="flex items-center gap-2">
			<button
				type="button"
				class="inline-flex items-center justify-center rounded-md p-2 hover:bg-sidebar-accent"
				onclick="
					const dark = document.documentElement.classList.toggle('dark');
					localStorage.setItem('theme', dark ? 'dark' : 'light');
				"
				title="Cambiar tema"
			>
				@icon.Sun(icon.Props{
					Class: "size-4 dark:hidden",
				})
				@icon.Moon(icon.Props{
					Class: "size-4 hidden dark:block",
				})
			</button>
			@dropdown.Dropdown() {
				@dropdown.Trigger() {
					<button class="flex items-center gap-2 rounded-md px-3 py-1 hover:bg-sidebar-accent">
						<span id="rol-seleccionado">
							{ nombreRolUnidad(roles, unidadid) }
						</span>
						@icon.ChevronDown(icon.Props{
							Class: "size-4",
						})
					</button>
				}
				@dropdown.Content(dropdown.ContentProps{
					Class: "w-72",
				}) {
					<div class="p-2">
						<input
							type="text"
							placeholder="Buscar rol o unidad..."
							class="w-full rounded-md border bg-background px-3 py-2 text-sm outline-none"
							oninput="
								const q = this.value.toLowerCase();
								document.querySelectorAll('#lista-roles [data-role]').forEach(e => {
									e.style.display = e.dataset.role.toLowerCase().includes(q) ? '' : 'none';
								});
							"
						/>
					</div>
					<div id="lista-roles">
						for _, r := range roles {
							@dropdown.Item(dropdown.ItemProps{
								Attributes: templ.Attributes{
									"data-role": r.Rol.Nombre + " " + r.Unidad.Nombre,
									"hx-post":   "/webx/setcookie/data",
									"hx-vals": fmt.Sprintf(
										`{"unidad_id":"%s","rol_id":"%s"}`,
										r.Unidad.ID,
										r.Rol.ID,
									),
									"hx-swap": "none",
									"onclick": fmt.Sprintf(
										"document.getElementById('rol-seleccionado').textContent = '%s'",
										r.Unidad.Nombre,
									),
								},
							}) {
								<div class="flex flex-col">
									<span class="font-medium">
										{ r.Unidad.Nombre }
									</span>
									<span class="text-xs text-muted-foreground">
										{ r.Rol.Nombre }
									</span>
								</div>
							}
						}
					</div>
				}
			}
		</div>
	</header>
}
