package ticket 

import (
	"github.com/dsaldias/server/graph_auth/model"
	"github.com/templui/templui/components/table"
	"github.com/dsaldias/server/dataadmin/pages/utility"
)

templ TicketsAll(tickets []*model.RespTickets,paginacion utility.MiPaginacion, url_refresh string) {
	@utility.TablaAdmin(utility.MiTablaProps{
		Titulo:      "Todos los tickets",
		Descripcion: "Administración y gestión de todos los tickets de soporte",
		UrlRefresh:  url_refresh,
		ListaID:     "lista-tickets-all",
		Acciones:    nil,
	},paginacion) {
		@ListaTicketsAll(tickets)
	}
}

templ ListaTicketsAll(tickets []*model.RespTickets) {
	@table.Table() {
		@table.Header() {
			@table.Row() {
				@table.Head() {
					ID
				}
				@table.Head() {
					Usuario
				}
				@table.Head() {
					Problema
				}
				@table.Head() {
					Respuestas
				}
				@table.Head() {
					Estado
				}
				@table.Head() {
					Fecha registro
				}
				@table.Head()
			}
		}
		@table.Body() {
			for _, ti := range tickets {
				@table.Row() {
					@table.Cell() {
						{ ti.ID }
					}
					@table.Cell() {
						{ ti.Usuario }
					}
					@table.Cell() {
						{ ti.Problema }
					}
					@table.Cell() {
						{ parseString(ti.Respuesta) }
					}
					@table.Cell() {
						{ ti.Estado }
					}
					@table.Cell() {
						{ parseTime(ti.FechaRegistro) }
					}
					@table.Cell(table.CellProps{Class: "m-0 p-0"}) {
						@utility.TablaAdminAcciones(
							ti.Problema,
						) {
							@utility.BtnVerTicket(ti)
							@utility.BtnResponderTicketAll(ti)
						}
					}
				}
			}
		}
	}
}
