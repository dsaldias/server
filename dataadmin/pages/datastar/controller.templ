package datastar

import (
	"database/sql"
	"fmt"
	"net/http"

	"github.com/dsaldias/server/dataadmin/pages/mainlayout"
)

type Controller struct {
	DB *sql.DB
	C  *mainlayout.MainController
}

func (c *Controller) Getsaludo(w http.ResponseWriter, r *http.Request) {
	fmt.Println("me han llamado")
	TemplSaludo().Render(r.Context(),w)
}

templ TemplSaludo() {
	<div id="hal">
		I'm sorry, Dave. I'm afraid I can't do that.
	</div>
}
