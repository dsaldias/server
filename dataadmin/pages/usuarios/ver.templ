package usuarios

import (
	"github.com/dsaldias/server/graph_auth/model"
)

templ Ver(
	for_edit model.ResponseUsuario,
	permisos []*model.Permiso,
	menus []*model.Menus,
) {
	<div class="space-y-6">

		<!-- DATOS PERSONALES -->
		<div class="rounded-lg border border-border bg-card p-4">
			<div class="mb-4">
				<h3 class="text-sm font-semibold">Datos personales</h3>
				<p class="text-xs text-muted-foreground">Información básica del usuario.</p>
			</div>
			<div class="grid gap-4 sm:grid-cols-2">

			@DatoVer("Nombres", for_edit.Nombres)
			@DatoVer("Primer apellido", for_edit.Apellido1)
			@DatoVer("Segundo apellido", parseStringx(for_edit.Apellido2))
			@DatoVer("Documento", parseStringx(for_edit.Documento))
			@DatoVer("Celular", parseStringx(for_edit.Celular))
			@DatoVer("Correo", parseStringx(for_edit.Correo))
			@DatoVer("Sexo", parseStringx(for_edit.Sexo))
			@DatoVer("Dirección", parseStringx(for_edit.Direccion))
			</div>
		</div>

		<!-- CUENTA -->
		<div class="rounded-lg border border-border bg-card p-4">
			<div class="mb-4">
				<h3 class="text-sm font-semibold">Cuenta</h3>
				<p class="text-xs text-muted-foreground">Datos de acceso del usuario.</p>
			</div>

			@DatoVer("Usuario", for_edit.Username)
		</div>

		@PanelAcceso2(
			for_edit.Roles,
			permisos,
			menus,
			for_edit.PermisosSueltos,
			for_edit.MenusSueltos,
		)

	</div>
	<script>
	(function () {
		const tabs = document.querySelectorAll('[data-user-access-tab]')
		const panels = document.querySelectorAll('[data-user-access-panel]')

		tabs.forEach((tab) => {
			tab.addEventListener('click', function () {
				const target = this.dataset.userAccessTab

				tabs.forEach((item) => {
					const active = item.dataset.userAccessTab === target
					item.setAttribute('aria-selected', active ? 'true' : 'false')
					item.classList.toggle('bg-sidebar', active)
					item.classList.toggle('text-sidebar-foreground', active)
					item.classList.toggle('text-muted-foreground', !active)
				})

				panels.forEach((panel) => {
					panel.classList.toggle('hidden', panel.dataset.userAccessPanel !== target)
				})
			})
		})
	})()
	</script>
}

templ PanelAcceso2(
	asignados []*model.ResponseRolUnidad,
	permisos []*model.Permiso,
	menus []*model.Menus,
	permisosSeleccionados []*model.ResponsePermisoMe,
	menusSeleccionados []*model.Menus,
) {
	<div class="space-y-3">
		<div class="rounded-lg border border-border bg-card p-1">
			<div class="grid grid-cols-3 gap-1" role="tablist" aria-label="Accesos del usuario">
				<button type="button" data-user-access-tab="roles" aria-selected="true" class="rounded-md bg-sidebar px-3 py-2 text-xs font-semibold text-sidebar-foreground transition-colors">
					Roles <span class="ml-1 opacity-80">({ len(asignados) })</span>
				</button>
				<button type="button" data-user-access-tab="menus" aria-selected="false" class="rounded-md px-3 py-2 text-xs font-semibold text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
					Menús <span class="ml-1 opacity-80">({ contarMenusSeleccionados(menus, menusSeleccionados) })</span>
				</button>
				<button type="button" data-user-access-tab="permisos" aria-selected="false" class="rounded-md px-3 py-2 text-xs font-semibold text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
					Permisos <span class="ml-1 opacity-80">({ contarPermisosSeleccionados(permisos, permisosSeleccionados) })</span>
				</button>
			</div>
		</div>
		@PanelRoles2(asignados)
		@PanelPermisos2(permisos, permisosSeleccionados)
		@PanelMenus2(menus, menusSeleccionados)
	</div>
}

templ DatoVer(
	label string,
	value string,
) {
	<div class="rounded-md border border-transparent bg-muted/20 px-3 py-2">
		<div class="text-xs text-muted-foreground">
			{ label }
		</div>

		<div class="mt-0.5 text-sm font-medium">
			{ value }
		</div>
	</div>
}

templ PanelRoles2(
	asignados []*model.ResponseRolUnidad,
) {
	<section data-user-access-panel="roles" class="rounded-lg border border-border bg-card">
		<div class="flex items-center justify-between border-b border-border bg-muted/40 px-4 py-3">
			<div>
				<h3 class="text-sm font-semibold">Roles y unidades</h3>
				<p class="text-xs text-muted-foreground">Asignaciones activas del usuario.</p>
			</div>
			<span class="rounded-full bg-accent px-2.5 py-1 text-xs font-semibold text-accent-foreground">
					{ len(asignados) } asignados
				</span>
			</div>
		<div class="space-y-1 p-3">
			for _, ru := range asignados {
				<div class="flex items-center rounded-md px-3 py-2 hover:bg-muted/50">
					<div class="flex-1 min-w-0">
						<div class="text-sm font-medium">
							{ ru.RolName }
						</div>

						<div class="text-xs text-muted-foreground">
							{ ru.UnidadName }
						</div>
					</div>
				</div>
			}
		</div>
	</section>
}

templ PanelPermisos2(
	permisos []*model.Permiso,
	seleccionados []*model.ResponsePermisoMe,
) {
	<section data-user-access-panel="permisos" class="hidden rounded-lg border border-border bg-card">
		<div class="flex items-center justify-between border-b border-border bg-muted/40 px-4 py-3">
			<div>
				<h3 class="text-sm font-semibold">Permisos globales</h3>
				<p class="text-xs text-muted-foreground">Acciones disponibles para este usuario.</p>
			</div>
			<span class="rounded-full bg-accent px-2.5 py-1 text-xs font-semibold text-accent-foreground">
					{ contarPermisosSeleccionados(permisos, seleccionados) } / { len(permisos) }
				</span>
			</div>
		<div class="space-y-2 p-3">
			for _, grupo := range agruparPermisos(permisos) {
				@PermisoGrupoItem2(grupo, seleccionados)
			}
		</div>
	</section>
}

templ PermisoGrupoItem2(
	grupo *PermisoGrupo,
	seleccionados []*model.ResponsePermisoMe,
) {
	<details class="rounded-md border border-border bg-background">
		<summary class="cursor-pointer list-none px-3 py-2.5 transition-colors hover:bg-muted/50">
			<div class="flex items-center">
				<span class="flex-1 text-sm font-medium">
					{ grupo.Nombre }
				</span>

				<span class="rounded-full bg-muted px-2 py-0.5 text-xs text-muted-foreground">
					{ contarPermisosGrupo(grupo.Permisos, seleccionados) } / { len(grupo.Permisos) }
				</span>
			</div>
		</summary>

		<div class="space-y-1 border-t border-border px-2 py-2">
			for _, permiso := range grupo.Permisos {
				if hasPermiso(seleccionados, permiso.Metodo) {
					<div class="rounded-md border border-border/50 bg-muted/10 px-3 py-2">
						<div class="text-sm font-medium">
							{ permiso.Nombre }
						</div>

						<div class="mt-0.5 inline-flex rounded bg-muted px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">
							{ permiso.Metodo }
						</div>

						if permiso.Descripcion != nil {
							<div class="text-xs text-muted-foreground mt-1">
								{ *permiso.Descripcion }
							</div>
						}
					</div>
				}
			}
		</div>
	</details>
}

templ PanelMenus2(
	menus []*model.Menus,
	seleccionados []*model.Menus,
) {
	<section data-user-access-panel="menus" class="hidden rounded-lg border border-border bg-card">
		<div class="flex items-center justify-between border-b border-border bg-muted/40 px-4 py-3">
			<div>
				<h3 class="text-sm font-semibold">Menús</h3>
				<p class="text-xs text-muted-foreground">Opciones visibles para el usuario.</p>
			</div>
			<span class="rounded-full bg-accent px-2.5 py-1 text-xs font-semibold text-accent-foreground">
					{ contarMenusSeleccionados(menus, seleccionados) } / { len(menus) }
				</span>
			</div>
		<div class="space-y-2 p-3">
			for _, item := range construirMenuTree(menus) {
				if hasMenu(seleccionados, item.Menu.ID) || len(item.Hijos) > 0 {
					@MenuTreeItem2(item, seleccionados)
				}
			}
		</div>
	</section>
}

templ MenuTreeItem2(
	item *MenuTree,
	seleccionados []*model.Menus,
) {
	<details class="rounded-md border border-border bg-background">
		<summary class="cursor-pointer list-none px-3 py-2.5 transition-colors hover:bg-muted/50">
			<div class="flex items-center gap-2">
				<div class="flex-1 min-w-0">
					<div class="text-sm font-medium">
						{ item.Menu.Label }
					</div>

					<div class="mt-0.5 inline-flex rounded bg-muted px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">
						{ item.Menu.Path }
					</div>
				</div>

				<div class="rounded-full bg-muted px-2 py-0.5 text-xs text-muted-foreground">
					{ len(item.Hijos) }
				</div>
			</div>
		</summary>

		if len(item.Hijos) > 0 {
			<div class="space-y-1 border-t border-border px-2 py-2">
				for _, hijo := range item.Hijos {
					if hasMenu(seleccionados, hijo.ID) {
						@MenuTreeChild2(hijo)
					}
				}
			</div>
		}
	</details>
}

templ MenuTreeChild2(
	menu *model.Menus,
) {
	<div class="rounded-md border border-border/50 bg-muted/10 px-3 py-2 pl-8">
		<div class="text-sm truncate">
			{ menu.Label }
		</div>

		<div class="mt-0.5 inline-flex rounded bg-muted px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">
			{ menu.Path }
		</div>
	</div>
}

func contarMenusSeleccionados(
	menus []*model.Menus,
	seleccionados []*model.Menus,
) int {
	total := 0

	for _, menu := range menus {
		if hasMenu(seleccionados, menu.ID) {
			total++
		}
	}

	return total
}
