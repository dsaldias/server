package usuarios 

import (
	"fmt"
	"github.com/dsaldias/server/dataadmin/pages/utility"
	"github.com/dsaldias/server/graph_auth/model"
	"github.com/templui/templui/components/selectbox"
	"github.com/templui/templui/components/table"
	"time"
)

templ Usuarios(usuarios []*model.Usuario, paginacion utility.MiPaginacion, url_refresh string) {
	@selectbox.Script()
	@utility.TablaAdmin(utility.MiTablaProps{
		Titulo:      "Usuarios registrados",
		Descripcion: "Administración y gestión de usuarios del sistema",
		UrlRefresh:  url_refresh,
		ListaID:     "lista-usuarios",
		DialogID:    "xdialog-form-usuario",
		Acciones:    HeaderAcciones(),
		Busqueda:    true,
		Ordenable:   true,
	}, paginacion) {
		@ListaUsuarios(usuarios, paginacion)
	}
}

templ ListaUsuarios(usuarios []*model.Usuario, paginacion utility.MiPaginacion) {
	@table.Table() {
		@table.Header() {
			@table.Row() {
				@table.Head() {
					ID
				}
				@table.Head() {
					Nombre completo
				}
				@table.Head() {
					Conexiones
				}
				@table.Head() {
					Último acceso
				}
				@table.Head(table.HeadProps{
					Attributes: templ.Attributes{
						"no-ordenar": "",
					},
				})
			}
		}
		@table.Body() {
			for _, us := range usuarios {
				@table.Row() {
					@table.Cell() {
						{ us.ID }
					}
					@table.Cell() {
						{ us.Nombres } { us.Apellido1 }
						{ parseString(us.Apellido2) }
					}
					@table.Cell() {
						{ us.Conexiones }
					}
					@table.Cell() {
						{ parseTime(us.LastLogin) }
					}
					@table.Cell(table.CellProps{Class: "m-0 p-0"}) {
						@utility.TablaAdminAcciones(
							fmt.Sprintf("%s %s %s", us.Nombres, us.Apellido1, parseString(us.Apellido2)),
						) {
							@utility.BtnVerUsuario(us)
							@utility.BtnEditarUsuario(us)
						}
						@utility.TablaAdminContextual(
							fmt.Sprintf("%s %s %s", us.Nombres, us.Apellido1, parseString(us.Apellido2)),
						) {
							@utility.BtnVerUsuario(us)
							@utility.BtnEditarUsuario(us)
						}
					}
				}
			}
		}
	}
	@utility.AdminTablePaginacion(paginacion)
}

templ HeaderAcciones() {
	@utility.BtnNewUsuario()
}

func parseTime(t *time.Time) string {
	if t == nil {
		return ""
	}
	return t.Format("02/01/2006 15:04")
}

func parseString(s *string) string {
	if s == nil {
		return ""
	}
	return *s
}
