package principal

import (
	"fmt"
	"github.com/dsaldias/server/dataadmin/pages/mainlayout/layoutconfig"
	"github.com/templui/templui/components/dropdown"
	"github.com/templui/templui/components/icon"
	"github.com/templui/templui/components/sidebar"

	xm "github.com/dsaldias/server/graph_auth/model"
)

type RolUnidadNombre struct {
	unidad string
	rol    string
}

func nombreUnidadRol(roles []*xm.ResponseRolMe, unidadid string) RolUnidadNombre {
	for _, r := range roles {
		if r.Unidad != nil && r.Rol != nil && r.Unidad.ID == unidadid {
			return RolUnidadNombre{
				unidad: r.Unidad.Nombre,
				rol:    r.Rol.Nombre,
			}
		}
	}

	return RolUnidadNombre{
		unidad: "Rol / Unidad",
		rol:    "",
	}
}

templ Header(roles []*xm.ResponseRolMe, unidadid string, config layoutconfig.Config) {
	<header class={ config.WithDefaults().HeaderClass }>
		<div class="flex items-center gap-3">
			@sidebar.Trigger(sidebar.TriggerProps{
				Class: "hover:bg-header-accent",
			})
		</div>
		<div class="flex items-center gap-2">
			<button
				type="button"
				class="inline-flex items-center justify-center rounded-md p-2 hover:bg-header-accent"
				onclick="
					const dark = document.documentElement.classList.toggle('dark');
					localStorage.setItem('theme', dark ? 'dark' : 'light');
				"
				title="Cambiar tema"
			>
				@icon.Sun(icon.Props{
					Class: "size-4 dark:hidden",
				})
				@icon.Moon(icon.Props{
					Class: "size-4 hidden dark:block",
				})
			</button>
			@dropdown.Dropdown() {
				@dropdown.Trigger() {
					<button class="flex items-center gap-2 rounded-md px-3 py-0 hover:bg-header-accent">
						<div class="min-w-0 max-w-fit flex flex-col text-left leading-tight">
							<span
								id="rol-seleccionado"
								class="whitespace-nowrap font-medium"
							>
								{ nombreUnidadRol(roles, unidadid).unidad }
							</span>
							<span
								class="truncate whitespace-nowrap text-xs text-muted-foreground"
								title={ nombreUnidadRol(roles, unidadid).rol }
							>
								{ nombreUnidadRol(roles, unidadid).rol }
							</span>
						</div>
						@icon.ChevronDown(icon.Props{
							Class: "size-4 shrink-0",
						})
					</button>
				}
				@dropdown.Content(dropdown.ContentProps{
					Class: "w-72",
				}) {
					<div class="p-2">
						<input
							type="text"
							placeholder="Buscar rol o unidad..."
							class="w-full rounded-md border bg-background px-3 py-2 text-sm outline-none"
							oninput="
								const q = this.value.toLowerCase();
								document.querySelectorAll('#lista-roles [data-role]').forEach(e => {
									e.style.display = e.dataset.role.toLowerCase().includes(q) ? '' : 'none';
								});
							"
						/>
					</div>
					<div id="lista-roles">
						for _, r := range roles {
							@dropdown.Item(dropdown.ItemProps{
								Attributes: templ.Attributes{
									"data-role": r.Rol.Nombre + " " + r.Unidad.Nombre,
									"hx-post":   "/adminx/setcookie/data",
									"hx-vals": fmt.Sprintf(
										`{"unidad_id":"%s","rol_id":"%s"}`,
										r.Unidad.ID,
										r.Rol.ID,
									),
									"hx-swap":   "innerHTML",
									"hx-target": "#x-sidebar-menus",
									"onclick": fmt.Sprintf(
										"document.getElementById('rol-seleccionado').textContent = '%s'",
										r.Unidad.Nombre,
									),
									"hx-on::after-request": `
										// const side = document.querySelector("#x-sidebar-menus");
										// console.log(side);
										document.querySelectorAll('[data-tui-collapsible="root"]').forEach((root) => {
											const trigger = root.querySelector(
													'[data-tui-collapsible="trigger"]'
											);

											const content = root.querySelector(
													'[data-tui-collapsible="content"]'
											);

											if (!trigger || !content) {
													return;
											}

											const open =
													root.getAttribute("data-tui-collapsible-state") === "open";

											trigger.setAttribute("aria-expanded", String(open));
											content.classList.toggle("tui-collapsible-open", open);
									});
									`,
								},
							}) {
								<div class="flex flex-col">
									<span class="font-medium">
										{ r.Unidad.Nombre }
									</span>
									<span class="text-xs text-muted-foreground">
										{ r.Rol.Nombre }
									</span>
								</div>
							}
						}
					</div>
				}
			}
		</div>
	</header>
}
