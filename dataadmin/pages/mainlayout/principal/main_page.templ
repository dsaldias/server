package principal

import (
	"github.com/dsaldias/server/dataadmin/pages/mainlayout/layoutconfig"
	"github.com/dsaldias/server/graph_auth/model"
	"github.com/templui/templui/components/sidebar"
)

templ MainPageLayout(
	isFromIframe bool,
	titulo string,
	subtitulo string,
	unidadid string,
	menus []*MenuGrupo,
	roles []*model.ResponseRolMe,
	usuario *model.ResponseUsuario,
	contenido templ.Component,
	current_path string,
	config layoutconfig.Config,
) {
	@Layout(titulo, config) {
		@sidebar.Layout() {
			@Sidebar(isFromIframe,titulo, subtitulo, current_path, menus, usuario, config, AssetVersion)
			@sidebar.Inset() {
				<div class={ config.WithDefaults().ShellClass }>
					@Header(isFromIframe,roles, unidadid, config)
					<main
						id="contenido"
						class={ config.WithDefaults().MainClass }
					>
						@contenido
					</main>
				</div>
			}
		}
	}
}
