package principal

import "github.com/dsaldias/server/graph_auth/model"

templ ModalAlerta(
	alertas []*model.Notificacion,
) {
	<div
		id="xmodal-alerta"
		class="fixed inset-0 z-[99999] hidden items-center justify-center bg-black/50 p-4 backdrop-blur-sm"
	>
		<div
			class="flex w-full max-w-lg max-h-[85vh] flex-col overflow-hidden rounded-xl border bg-card shadow-2xl"
		>
			<!-- Header -->
			<div class="border-b px-6 py-5">
				<div class="flex items-start gap-4">
					<div class="flex size-11 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="22"
							height="22"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d="M10.268 21a2 2 0 0 0 3.464 0"/>
							<path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"/>
						</svg>
					</div>

					<div class="min-w-0">
						<h1 class="text-lg font-semibold leading-none">
							Avisos y notificaciones
						</h1>

						<p class="mt-2 text-sm text-muted-foreground">
							Información importante del sistema
						</p>
					</div>
				</div>
			</div>

			<!-- Contenido -->
			<div class="flex-1 overflow-y-auto p-4">
				if len(alertas) == 0 {
					<div class="flex flex-col items-center justify-center py-12 text-center">
						<div class="flex size-12 items-center justify-center rounded-full bg-muted">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="22"
								height="22"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								class="text-muted-foreground"
							>
								<path d="M20 6 9 17l-5-5"/>
							</svg>
						</div>

						<p class="mt-4 text-sm font-medium">
							No tienes avisos pendientes
						</p>

						<p class="mt-1 text-xs text-muted-foreground">
							El sistema no tiene notificaciones para mostrar.
						</p>
					</div>
				} else {
					<div class="space-y-3">
						for _, a := range alertas {
							<div class="group rounded-lg border bg-background p-4 transition-colors hover:bg-muted/40">
								<div class="flex gap-3">
									<!-- Indicador -->
									<div class="mt-1 flex size-2.5 shrink-0 rounded-full bg-primary"></div>

									<div class="min-w-0 flex-1">
										<!-- Mensaje -->
										<p class="text-sm leading-6">
											{ a.Mensaje }
										</p>

										<!-- Metadata -->
										<div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-muted-foreground">
											<div class="flex items-center gap-1.5">
												<svg
													xmlns="http://www.w3.org/2000/svg"
													width="14"
													height="14"
													viewBox="0 0 24 24"
													fill="none"
													stroke="currentColor"
													stroke-width="2"
													stroke-linecap="round"
													stroke-linejoin="round"
												>
													<circle cx="12" cy="12" r="10"/>
													<polyline points="12 6 12 12 16 14"/>
												</svg>

												<span>
													Desde { a.Desde.Format("02/01/2006 15:04") }
												</span>
											</div>

											<div class="flex items-center gap-1.5">
												<span>
													Hasta { a.Hasta.Format("02/01/2006 15:04") }
												</span>
											</div>
										</div>

										<!-- Fecha registro -->
										<p class="mt-2 text-[11px] text-muted-foreground/70">
											Registrado el { a.FechaRegistro.Format("02/01/2006 15:04") }
										</p>
									</div>
								</div>
							</div>
						}
					</div>
				}
			</div>

			<!-- Footer -->
			<div class="flex items-center justify-between border-t bg-muted/20 px-6 py-3">
				<p class="text-xs text-muted-foreground">
					{ len(alertas) } notificaciones
				</p>

				<button
					type="button"
					class="rounded-md px-3 py-2 text-sm font-medium hover:bg-muted"
					onclick="this.closest('#xmodal-alerta')?.remove()"
				>
					Cerrar
				</button>
			</div>
		</div>
	</div>
}