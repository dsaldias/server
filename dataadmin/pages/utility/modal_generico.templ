package utility

import (
	"github.com/templui/templui/components/button"
	"github.com/templui/templui/components/dialog"
	"github.com/templui/templui/components/icon"
)

const (
	ModalSM  = "max-w-sm"
	ModalMD  = "max-w-md"
	ModalLG  = "max-w-lg"
	ModalXL  = "max-w-xl"
	Modal2XL = "max-w-2xl"
	Modal3XL = "max-w-3xl"
	Modal4XL = "max-w-4xl"
	Modal5XL = "max-w-5xl"
	Modal6XL = "max-w-6xl"
	Modal7XL = "max-w-7xl"
)

type ModalGenericoX struct {
	DialogID          string
	TargetRefreshID   string
	DialogClass       string
	DisableCustomForm bool
	// DialogSize      string
}

templ ModalGenerico(p ModalGenericoX) {
	@dialog.Dialog(dialog.Props{
		ID:               p.DialogID,
		DisableClickAway: true,
		Class:            "z-[99999]",
	}) {
		@dialog.Content(dialog.ContentProps{
			// max-w-2xl, max-w-5xl, max-w-7xl
			// Class:        modalDialogClass(p.DialogClass),
			Class:        "relative " + modalDialogClass(p.DialogClass),
			DisableModal: false,
			Attributes: templ.Attributes{
				"data-mobile-modal": "true",
				"id":                "modal-content-" + p.DialogID,
			},
		}) {
			@dialog.Header() {
				@dialog.Title() {
					<span id={ "titulo-" + p.DialogID }></span>
				}
				@dialog.Description() {
					<span id={ "descripcion-" + p.DialogID }></span>
				}
			}
			@button.Button(button.Props{
				ID:      "btn-expandir-" + p.DialogID,
				Variant: button.VariantGhost,
				Type:    "button",
				Class:   "absolute right-12 top-2 h-8 w-8 p-0 z-10",
			}) {
				<span
					id={ "icon-expandir-" + p.DialogID }
					class="text-lg leading-none"
					title="Expandir"
				>
					⛶
				</span>
			}
			<div class="overflow-y-auto flex-1 pr-2">
				if p.DisableCustomForm {
					<div class="xoverflow-y-auto flex-1 pr-2">
						<div id={ "xcontenido-" + p.DialogID }>
							{ children... }
						</div>
					</div>
					
				} else {
					<form
						id={ "xform-" + p.DialogID }
						hx-post=""
						hx-target={ p.TargetRefreshID }
						hx-swap="innerHTML"
						hx-ext="json-enc-custom"
						class="space-y-5"
						hx-on::before-request="
						const d = this.parentElement.parentElement;
						this.dataset.submitButton = d.querySelector('button[type=submit]').innerHTML;
						const button = d.querySelector('button[type=submit]');
						button.disabled = true;
						button.innerHTML = '<span class=animate-spin inline-block>↻</span> Registrando...';
					"
						hx-on::after-request="
						const d = this.parentElement.parentElement;
						const button = d.querySelector('button[type=submit]');
						button.disabled = false;
						button.innerHTML = this.dataset.submitButton;

						if (event.detail.successful) {
							this.closest('dialog').close();
							Toastify({ text: 'Operacion realizada con exito',style: {background:'green',zindex:999999}, duration: 5000, close: true, gravity: 'top', position: 'right' }).showToast()
						}
					"
					>
						<div class="xoverflow-y-auto flex-1 pr-2">
							<div id={ "xcontenido-" + p.DialogID }>
								{ children... }
							</div>
						</div>
					</form>
				}
				<div id={ "resultado-" + p.DialogID }></div>
			</div>
			@dialog.Footer() {
				<div id={ "footer-" + p.DialogID } class="flex gap-2">
					@dialog.Close(dialog.CloseProps{
						ID: "btn-cerrar-" + p.DialogID,
					}) {
						@button.Button(button.Props{
							Variant: button.VariantOutline,
							Type:    "button",
							Class:   "bg-red-100 text-red-700 hover:bg-red-200",
						}) {
							@icon.PanelLeftClose()
							<span class="btn-cerrar-text">Cancelar</span>
						}
					}
					@button.Button(button.Props{
						ID:      "btn-submit-" + p.DialogID,
						Variant: button.VariantOutline,
						Type:    "submit",
						Class:   "bg-green-100 text-green-700 hover:bg-green-200",
						Form:    "xform-" + p.DialogID,
					}) {
						@icon.Check()
						<span class="btn-submit-text">Aceptar</span>
					}
				</div>
			}
		}
	}
	/* <script>
	document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll('[data-mobile-modal]').forEach(dialog => {
        const mobile = window.matchMedia("(max-width: 767px)").matches;

        dialog.dataset.tuiDialogShowModal = !mobile ? "true" : "false";
    });
});
	</script> */
	<script>
	if (!window.modalGenericoExpandirInicializado) {
		window.modalGenericoExpandirInicializado = true;

		document.addEventListener("click", (event) => {
			const button = event.target.closest('[id^="btn-expandir-"]');

			if (!button) {
				return;
			}

			event.preventDefault();
			event.stopPropagation();

			const dialogID = button.id.replace("btn-expandir-", "");
			const content = document.getElementById("modal-content-" + dialogID);
			const icon = document.getElementById("icon-expandir-" + dialogID);

			if (!content) {
				return;
			}

			const expandido = content.dataset.expanded === "true";

			if (expandido) {
				content.style.width = "";
				content.style.maxWidth = "";

				content.dataset.expanded = "false";

				if (icon) {
					icon.textContent = "⛶";
					icon.title = "Expandir";
				}
			} else {
				content.style.width = "90vw";
				content.style.maxWidth = "90vw";

				content.dataset.expanded = "true";

				if (icon) {
					icon.textContent = "⛶";
					icon.title = "Restaurar";
				}
			}
		});
	}
</script>
}

func modalDialogClass(class string) string {
	if class != "" {
		return class
	}
	return "max-h-[90vh] flex flex-col z-[99999]"
}
