package utility

import (
	"fmt"
	"github.com/templui/templui/components/button"
	"github.com/templui/templui/components/card"
	"github.com/templui/templui/components/icon"
	"github.com/templui/templui/components/pagination"
	"github.com/templui/templui/components/popover"
)

type MiTablaProps struct {
	Titulo             string
	Descripcion        string
	UrlRefresh         string
	ListaID            string
	DialogID           string
	DialogContentClass string
	DialogHeaderClass  string
	DialogFooterClass  string
	HeaderClass        string
	Acciones           templ.Component
	Busqueda           bool
	Ordenable          bool
	// FilasPorPagina     int
}

type MiPaginacion struct {
	Paginas    int
	Pagina     int
	Size       int
	Tab        string
	TargetHtmx string
}

type ItemPaginacion struct {
	Pagina   int
	EsActual bool
	EsSalto  bool
}

templ TablaAdmin(
	props MiTablaProps,
	paginacion MiPaginacion,
) {
	<div
		if props.HeaderClass == "" {
			class="px-3 py-1 mb-1"
		} else {
			class={ props.HeaderClass }
		}
	>
		@card.Card(card.Props{
			Class: "border-border bg-card",
		}) {
			@card.Content() {
				<div class="mb-2 grid grid-cols-1 md:grid-cols-2 md:items-center">
					<div class="text-left">
						<h2 class="text-lg font-semibold">{ props.Titulo }</h2>
						<p class="text-sm text-muted-foreground">
							{ props.Descripcion }
						</p>
					</div>
					<div
						class="md:flex md:items-center md:justify-end"
						data-modal-refresh-target={ "#" + props.ListaID }
					>
						@TablaAdminHeaderAcciones(props.UrlRefresh, props.ListaID) {
							if props.Acciones != nil {
								@props.Acciones
							}
						}
					</div>
				</div>
				if props.Busqueda {
					@TablaAdminBusqueda(props.ListaID)
				}
			}
		}
	</div>
	@TablaAdminLista(props, paginacion) {
		{ children... }
	}
}

templ TablaAdminBusqueda(lista_id string) {
	<div class="mb-1">
		<div class="relative max-w-sm">
			<input
				type="text"
				placeholder="Buscar..."
				class="w-full rounded-md border border-input z-[1] bg-background px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-ring"
				data-tabla-busqueda={ lista_id }
				autocomplete="off"
			/>
		</div>
	</div>
}

templ TablaAdminHeaderAcciones(
	url_refresh string,
	lista_id string,
) {
	<div class="flex items-center gap-2 mb-0">
		if url_refresh != "" {
			@button.Button(button.Props{
				Variant: button.VariantOutline,
				Size:    button.SizeSm,
				Class:   "border-border bg-card text-card-foreground hover:bg-muted hover:text-foreground",
				Attributes: templ.Attributes{
					"hx-get":          url_refresh,
					"hx-disabled-elt": "this",
					"hx-target":       "#" + lista_id,
					"hx-swap":         "innerHTML",
				},
			}) {
				@icon.RefreshCw()
				Refrescar
			}
		}
		{ children... }
	</div>
}

templ TablaAdminAcciones(
	nombre string,
) {
	@popover.Root() {
		@popover.Trigger(popover.TriggerProps{
			TriggerType: popover.TriggerTypeHover,
		}) {
			@button.Button(button.Props{
				Class:   "border-border bg-card text-card-foreground hover:bg-accent hover:text-accent-foreground",
				Variant: button.VariantOutline,
				Size:    button.SizeIcon,
			}) {
				@icon.Menu(icon.Props{})
			}
		}
		@popover.Content(popover.ContentProps{
			Class:         "border border-border",
			Placement:     popover.PlacementLeft,
			ShowArrow:     true,
			HoverOutDelay: 500,
		}) {
			<div class="min-w-56 space-y-4 rounded-md border border-border bg-card p-4 text-card-foreground shadow-lg">
				<div class="border-b border-border pb-3">
					<p class="text-sm font-semibold">
						Menú de opciones
					</p>
					<p class="text-xs text-muted-foreground">
						{ nombre }
					</p>
				</div>
				<div class="flex items-center gap-2">
					{ children... }
				</div>
			</div>
		}
	}
}

templ TablaAdminContextual(t string) {
	<div
		data-contextual-menu
		class="hidden fixed z-[9999] w-fit rounded-md border border-border bg-card text-card-foreground p-2 shadow-lg"
	>
		<div class="border-b border-border px-3 py-2">
			<p class="text-sm font-semibold">
				Menú de opciones
			</p>
			<p class="text-xs text-muted-foreground">
				{ t }
			</p>
		</div>
		<div class="mt-2 flex items-center gap-2">
			{ children... }
		</div>
	</div>
}

templ TablaAdminLista(props MiTablaProps, paginacion MiPaginacion) {
	<div class="overflow-hidden mx-2">
		@card.Card(card.Props{
			Class: `
			border-border bg-card
			[&_table_thead]:bg-table-header
			[&_table_thead]:border-0
			[&_table_thead_tr]:border-0
			[&_table_thead_th]:border-0

			[&_table_tbody_tr]:border-b
			[&_table_tbody_tr]:border-border/50
			[&_table_tbody_tr:nth-child(even)]:bg-table-row-even
			[&_table_tbody_tr:nth-child(odd)]:bg-table-row-odd
			[&_table_tbody_tr:hover]:bg-table-row-hover
			[&_table_tbody_tr:hover_td]:bg-table-row-hover

			[&_table_tbody_td]:border-0
			[&_table_tbody_td]:py-1
			[&_table_tbody_td]:px-2
			`,
		}) {
			@card.Content(card.ContentProps{
				ID: props.ListaID,
				Attributes: templ.Attributes{
					"data-tabla-contextual": "true",
					"data-tabla-ordenable":  isSorted(props),
					/* "data-filas-por-pagina": fmt.Sprint(props.FilasPorPagina),
					"data-tabla-paginable":  isPaged(props), */
				},
			}) {
				{ children... }
			}
		}
	</div>
}

templ AdminTablePaginacion(paginacion MiPaginacion) {
	@pagination.Pagination(pagination.Props{
		Class: "mt-8 mb-2",
	}) {
		@pagination.Content() {
			@pagination.Item() {
				@pagination.Previous(pagination.PreviousProps{
					Href:     paginaURL(paginacion.Pagina-1, paginacion.Size, paginacion.Tab),
					Disabled: paginacion.Pagina <= 1,
					Label:    "Anterior",
					Attributes: templ.Attributes{
						"hx-get":      paginaURL(paginacion.Pagina-1, paginacion.Size, paginacion.Tab),
						"hx-target":   paginacion.TargetHtmx,
						"hx-swap":     "innerHTML",
						"hx-push-url": "true",
					},
				})
			}
			for _, item := range generarPaginas(paginacion) {
				if item.EsSalto {
					@pagination.Item() {
						<span class="px-2">...</span>
					}
				} else {
					@pagination.Link(pagination.LinkProps{
						Href:     paginaURL(item.Pagina, paginacion.Size, paginacion.Tab),
						IsActive: item.EsActual,
						Attributes: templ.Attributes{
							"hx-get":      paginaURL(item.Pagina, paginacion.Size, paginacion.Tab),
							"hx-target":   paginacion.TargetHtmx,
							"hx-swap":     "innerHTML",
							"hx-push-url": "true",
						},
					}) {
						{ fmt.Sprintf("%d", item.Pagina) }
					}
				}
			}
			@pagination.Item() {
				@pagination.Next(pagination.NextProps{
					Href:     paginaURL(paginacion.Pagina+1, paginacion.Size, paginacion.Tab),
					Disabled: paginacion.Pagina >= paginacion.Paginas,
					Label:    "Siguiente",
					Attributes: templ.Attributes{
						"hx-get":      paginaURL(paginacion.Pagina+1, paginacion.Size, paginacion.Tab),
						"hx-target":   paginacion.TargetHtmx,
						"hx-swap":     "innerHTML",
						"hx-push-url": "true",
					},
				})
			}
		}
	}
}
