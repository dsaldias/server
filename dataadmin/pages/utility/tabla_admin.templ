package utility

import (
	"fmt"
	"github.com/templui/templui/components/button"
	"github.com/templui/templui/components/card"
	"github.com/templui/templui/components/icon"
	"github.com/templui/templui/components/popover"
)

type MiTablaProps struct {
	Titulo             string
	Descripcion        string
	UrlRefresh         string
	ListaID            string
	DialogID           string
	DialogContentClass string
	DialogHeaderClass  string
	DialogFooterClass  string
	HeaderClass        string
	Acciones           templ.Component
	Busqueda           bool
	Ordenable          bool
	FilasPorPagina     int
}

templ TablaAdmin(
	props MiTablaProps,
) {
	<div
		if props.HeaderClass == "" {
			class="px-3 py-1 mb-1"
		} else {
			class={ props.HeaderClass }
		}
	>
		@card.Card(card.Props{
			Class: "border-border bg-card",
		}) {
			@card.Content() {
				<div class="mb-2 grid grid-cols-1 md:grid-cols-2 md:items-center">
					<div class="text-left">
						<h2 class="text-lg font-semibold">{ props.Titulo }</h2>
						<p class="text-sm text-muted-foreground">
							{ props.Descripcion }
						</p>
					</div>
					<div class="md:flex md:items-center md:justify-end">
						@TablaAdminHeaderAcciones(props.UrlRefresh, props.ListaID) {
							if props.Acciones != nil {
								@props.Acciones
							}
						}
					</div>
				</div>
				if props.Busqueda {
					@TablaAdminBusqueda(props.ListaID)
				}
			}
		}
		@ModalGenerico(ModalGenericoX{
			DialogID:           props.DialogID,
			TargetRefreshID:    "#" + props.ListaID,
			DialogContentClass: props.DialogContentClass,
			DialogHeaderClass:  props.DialogHeaderClass,
			DialogFooterClass:  props.DialogFooterClass,
		})
	</div>
	@TablaAdminLista(props) {
		{ children... }
	}
}

templ TablaAdminBusqueda(lista_id string) {
	<div class="mb-1">
		<div class="relative max-w-sm">
			<input
				type="text"
				placeholder="Buscar..."
				class="w-full rounded-md border border-input z-[1] bg-background px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-ring"
				data-tabla-busqueda={ lista_id }
				autocomplete="off"
			/>
		</div>
	</div>
}

templ TablaAdminHeaderAcciones(
	url_refresh string,
	lista_id string,
) {
	<div class="flex items-center gap-2 mb-0">
		if url_refresh != "" {
			@button.Button(button.Props{
				Variant: button.VariantOutline,
				Size:    button.SizeSm,
				Class:   "border-border bg-card text-card-foreground hover:bg-muted hover:text-foreground",
				Attributes: templ.Attributes{
					"hx-get":          url_refresh,
					"hx-disabled-elt": "this",
					"hx-target":       "#" + lista_id,
					"hx-swap":         "innerHTML",
				},
			}) {
				@icon.RefreshCw()
				Refrescar
			}
		}
		{ children... }
	</div>
}

templ TablaAdminAcciones(
	nombre string,
) {
	@popover.Root() {
		@popover.Trigger(popover.TriggerProps{
			TriggerType: popover.TriggerTypeHover,
		}) {
			@button.Button(button.Props{
				Class:   "border-border bg-card text-card-foreground hover:bg-accent hover:text-accent-foreground",
				Variant: button.VariantOutline,
				Size:    button.SizeIcon,
			}) {
				@icon.Menu(icon.Props{})
			}
		}
		@popover.Content(popover.ContentProps{
			Class:         "border border-border",
			Placement:     popover.PlacementLeft,
			ShowArrow:     true,
			HoverOutDelay: 500,
		}) {
			<div class="min-w-56 space-y-4 rounded-md border border-border bg-card p-4 text-card-foreground shadow-lg">
				<div class="border-b border-border pb-3">
					<p class="text-sm font-semibold">
						Menú de opciones
					</p>
					<p class="text-xs text-muted-foreground">
						{ nombre }
					</p>
				</div>
				<div class="flex items-center gap-2">
					{ children... }
				</div>
			</div>
		}
	}
}

templ TablaAdminContextual(t string) {
	<div
		data-contextual-menu
		class="hidden fixed z-[9999] w-56 rounded-md border border-border bg-card text-card-foreground p-2 shadow-lg"
	>
		<div class="border-b border-border px-3 py-2">
			<p class="text-sm font-semibold">
				Menú de opciones
			</p>
			<p class="text-xs text-muted-foreground">
				{ t }
			</p>
		</div>
		<div class="mt-2 flex items-center gap-2">
			{ children... }
		</div>
	</div>
}

templ TablaAdminPaginacion(lista_id string) {
	<div
		class="mt-3 mr-2 flex items-center justify-between border-t border-border/50 pt-2"
		data-tabla-paginacion={ lista_id }
	>
		<div
			class="ml-2 text-sm text-muted-foreground"
			data-paginacion-info
		></div>
		<div
			class="flex items-center gap-1"
			data-paginacion-controles
		></div>
	</div>
}

templ TablaAdminLista(props MiTablaProps) {
	<div class="overflow-hidden mx-2">
		@card.Card(card.Props{
			Class: `
			border-border bg-card
			[&_table_thead]:bg-table-header
			[&_table_thead]:border-0
			[&_table_thead_tr]:border-0
			[&_table_thead_th]:border-0

			[&_table_tbody_tr]:border-b
			[&_table_tbody_tr]:border-border/50
			[&_table_tbody_tr:nth-child(even)]:bg-table-row-even
			[&_table_tbody_tr:nth-child(odd)]:bg-table-row-odd

			[&_table_tbody_td]:border-0
			[&_table_tbody_td]:py-1
			[&_table_tbody_td]:px-2
			`,
		}) {
			@card.Content(card.ContentProps{
				ID: props.ListaID,
				Attributes: templ.Attributes{
					"data-tabla-contextual": "true",
					"data-tabla-ordenable":  isSorted(props),
					"data-filas-por-pagina": fmt.Sprint(props.FilasPorPagina),
					"data-tabla-paginable":  isPaged(props),
				},
			}) {
				{ children... }
			}
			if props.FilasPorPagina > 0 {
				@TablaAdminPaginacion(props.ListaID)
			}
		}
	</div>
}

func isSorted(props MiTablaProps) string {
	if props.Ordenable {
		return "true"
	}
	return "false"
}

func isPaged(props MiTablaProps) string {
	if props.FilasPorPagina > 0 {
		return "true"
	}
	return "false"
}
