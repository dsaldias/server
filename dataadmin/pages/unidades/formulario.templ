package unidades

import (
	"fmt"

	"github.com/dsaldias/server/graph_auth/model"
	"github.com/templui/templui/components/input"
)

templ Formulario(
	for_edit model.Unidad,
) {
	<div class="space-y-6">

		<div class="hidden">
			@input.Input(input.Props{
				ID:       "id",
				Name:     "id",
				Value:    for_edit.ID,
				Readonly: true,
			})
		</div>

		<div class="space-y-3">
			<h3 class="text-sm font-semibold">Datos de la unidad</h3>

			@input.Input(input.Props{
				ID:          "nombre",
				Name:        "nombre",
				Placeholder: "Nombre",
				Value:       for_edit.Nombre,
			})

			@input.Input(input.Props{
				ID:          "descripcion",
				Name:        "descripcion",
				Placeholder: "Descripción",
				Value:       parseStringx(for_edit.Descripcion),
			})

			@input.Input(input.Props{
				ID:          "latitud",
				Name:        "latitud",
				Type:        "number",
				Value:       fmt.Sprintf("%f", parseFloatx(for_edit.Latitud)),
			})

			@input.Input(input.Props{
				ID:          "longitud",
				Name:        "longitud",
				Type:        "number",
				Value:       fmt.Sprintf("%f", parseFloatx(for_edit.Longitud)),
			})

			@input.Input(input.Props{
				ID:       "orden",
				Name:     "orden",
				Type:     "number",
				Value:    fmt.Sprintf("%d", for_edit.Orden),
			})
		</div>

	</div>
}

func parseFloatx(v *float64) float64 {
	if v == nil {
		return 0
	}
	return *v
}

func parseStringx(s *string) string {
	if s == nil {
		return ""
	}
	return *s
}