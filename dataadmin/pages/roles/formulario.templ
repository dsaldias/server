package roles

import (
	"fmt"

	"github.com/dsaldias/server/graph_auth/model"
	"github.com/templui/templui/components/input"
)

templ Formulario(
	for_edit model.Rol,
	menus []*model.Menus,
	permisos []*model.Permiso,
) {
	<div class="space-y-6">
		<div class="hidden">
			@input.Input(input.Props{
				ID:       "id",
				Name:     "id",
				Value:    fmt.Sprintf("%s", for_edit.ID),
				Readonly: true,
			})
		</div>
		<div class="space-y-3 rounded-lg border border-border bg-card p-4">
			<div>
				<h3 class="text-sm font-semibold">Datos del rol</h3>
				<p class="text-xs text-muted-foreground">Define la identidad y el nivel de acceso del rol.</p>
			</div>
			@input.Input(input.Props{
				ID:          "nombre",
				Name:        "nombre",
				Placeholder: "Nombre",
				Value:       for_edit.Nombre,
			})
			@input.Input(input.Props{
				ID:          "descripcion",
				Name:        "descripcion",
				Placeholder: "Descripción",
				Value:       parseStringx(for_edit.Descripcion),
			})
			@input.Input(input.Props{
				ID:    "jerarquia",
				Name:  "jerarquia",
				Type:  "number",
				Value: fmt.Sprintf("%d", for_edit.Jerarquia),
			})
		</div>
		@PanelAcceso(menus, permisos, for_edit.Menus, for_edit.Permisos)
	</div>
	<script>
	(function () {
		const tabs = document.querySelectorAll('[data-role-access-tab]')
		const panels = document.querySelectorAll('[data-role-access-panel]')

		tabs.forEach((tab) => {
			tab.addEventListener('click', function () {
				const target = this.dataset.roleAccessTab

				tabs.forEach((item) => {
					const active = item.dataset.roleAccessTab === target
					item.setAttribute('aria-selected', active ? 'true' : 'false')
					item.classList.toggle('bg-sidebar', active)
					item.classList.toggle('text-sidebar-foreground', active)
					item.classList.toggle('text-muted-foreground', !active)
				})

				panels.forEach((panel) => {
					panel.classList.toggle('hidden', panel.dataset.roleAccessPanel !== target)
				})
			})
		})
	})()
	</script>
}

templ PanelAcceso(
	menus []*model.Menus,
	permisos []*model.Permiso,
	menusSeleccionados []*model.Menus,
	permisosSeleccionados []*model.ResponsePermisoMe,
) {
	<div class="space-y-3">
		<div class="rounded-lg border border-border bg-card p-1">
			<div class="grid grid-cols-2 gap-1" role="tablist" aria-label="Configuración del rol">
				<button type="button" data-role-access-tab="permisos" aria-selected="true" class="rounded-md bg-sidebar px-3 py-2 text-xs font-semibold text-sidebar-foreground transition-colors">
					Permisos <span class="ml-1 opacity-80">({ contarPermisosSeleccionados(permisos, permisosSeleccionados) })</span>
				</button>
				<button type="button" data-role-access-tab="menus" aria-selected="false" class="rounded-md px-3 py-2 text-xs font-semibold text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
					Menús <span class="ml-1 opacity-80">({ contarMenusSeleccionados(menus, menusSeleccionados) })</span>
				</button>
			</div>
		</div>
		@PanelPermisos(permisos, permisosSeleccionados)
		@PanelMenus(menus, menusSeleccionados)
	</div>
}

templ PanelPermisos(
	permisos []*model.Permiso,
	seleccionados []*model.ResponsePermisoMe,
) {
	<section data-role-access-panel="permisos" class="rounded-lg border border-border bg-card">
		<div class="flex items-center justify-between border-b border-border bg-muted/40 px-4 py-3">
			<div>
				<h3 class="text-sm font-semibold">Permisos</h3>
				<p class="text-xs text-muted-foreground">Define las acciones que este rol puede ejecutar.</p>
			</div>
			<span class="rounded-full bg-accent px-2.5 py-1 text-xs font-semibold text-accent-foreground">
				{ contarPermisosSeleccionados(permisos, seleccionados) } / { len(permisos) }
			</span>
		</div>
		<div class="space-y-2 p-3">
			for _, grupo := range agruparPermisos(permisos) {
				@PermisoGrupoItem(grupo, seleccionados)
			}
		</div>
	</section>
}

templ PermisoGrupoItem(
	grupo *PermisoGrupo,
	seleccionados []*model.ResponsePermisoMe,
) {
	<details class="rounded-md border border-border bg-background">
		<summary class="cursor-pointer list-none px-3 py-2.5 transition-colors hover:bg-muted/50">
			<div class="flex items-center">
				<span class="flex-1 text-sm font-medium">
					{ grupo.Nombre }
				</span>
				<span class="rounded-full bg-muted px-2 py-0.5 text-xs text-muted-foreground">
					{ contarPermisosGrupo(grupo.Permisos, seleccionados) } / { len(grupo.Permisos) }
				</span>
			</div>
		</summary>
		<div class="space-y-1 border-t border-border px-2 py-2">
			for _, permiso := range grupo.Permisos {
				<label class="flex cursor-pointer items-start gap-3 rounded-md border border-transparent px-3 py-2 transition-colors hover:border-border hover:bg-muted/50 has-[:checked]:border-accent has-[:checked]:bg-accent/10">
					<input
						type="checkbox"
						name="permisos"
						value={ permiso.Metodo }
						if hasPermiso(seleccionados, permiso.Metodo) {
							checked
						}
					/>
					<div class="min-w-0 flex-1">
						<div class="text-sm font-medium">
							{ permiso.Nombre }
						</div>
						<div class="mt-0.5 inline-flex rounded bg-muted px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">
							{ permiso.Metodo }
						</div>
						if permiso.Descripcion != nil {
							<div class="text-xs text-muted-foreground mt-1">
								{ *permiso.Descripcion }
							</div>
						}
					</div>
				</label>
			}
		</div>
	</details>
}

templ PanelMenus(
	menus []*model.Menus,
	seleccionados []*model.Menus,
) {
	<section data-role-access-panel="menus" class="hidden rounded-lg border border-border bg-card">
		<div class="flex items-center justify-between border-b border-border bg-muted/40 px-4 py-3">
			<div>
				<h3 class="text-sm font-semibold">Menús</h3>
				<p class="text-xs text-muted-foreground">Define las opciones que este rol podrá visualizar.</p>
			</div>
			<span class="rounded-full bg-accent px-2.5 py-1 text-xs font-semibold text-accent-foreground">
				{ contarMenusSeleccionados(menus, seleccionados) } / { len(menus) }
			</span>
		</div>
		<div class="space-y-2 p-3">
			for _, item := range construirMenuTree(menus) {
				@MenuTreeItem(item, seleccionados)
			}
		</div>
	</section>
}

templ MenuTreeItem(
	item *MenuTree,
	seleccionados []*model.Menus,
) {
	<details class="rounded-md border border-border bg-background">
		<summary class="cursor-pointer list-none px-3 py-2.5 transition-colors hover:bg-muted/50">
			<div class="flex items-center gap-2">
				<input
					type="checkbox"
          x-json-type="number"
					name="menus"
					value={ item.Menu.ID }
					if hasMenu(seleccionados, item.Menu.ID) {
						checked
					}
					onclick="event.stopPropagation()"
				/>
				<div class="min-w-0 flex-1">
					<div class="text-sm font-medium">
						{ item.Menu.Label }
					</div>
					<div class="text-[11px] text-muted-foreground truncate">
						{ item.Menu.Path }
					</div>
				</div>
				<div class="rounded-full bg-muted px-2 py-0.5 text-xs text-muted-foreground">
					{ len(item.Hijos) }
				</div>
			</div>
		</summary>
		if len(item.Hijos) > 0 {
			<div class="space-y-1 border-t border-border px-2 py-2">
				for _, hijo := range item.Hijos {
					@MenuTreeChild(hijo, seleccionados)
				}
			</div>
		}
	</details>
}

templ MenuTreeChild(
	menu *model.Menus,
	seleccionados []*model.Menus,
) {
	<label class="flex cursor-pointer items-center gap-3 rounded-md border border-transparent px-3 py-2 pl-8 transition-colors hover:border-border hover:bg-muted/50 has-[:checked]:border-accent has-[:checked]:bg-accent/10">

		<input
			type="checkbox"
			name="menus"
			value={ menu.ID }
			if hasMenu(seleccionados, menu.ID) {
				checked
			}
		/>
		<div class="min-w-0 flex-1">
			<div class="text-sm truncate">
				{ menu.Label }
			</div>
			<div class="text-[11px] text-muted-foreground truncate">
				{ menu.Path }
			</div>
		</div>
	</label>
}

func parseStringx(s *string) string {
	if s == nil {
		return ""
	}
	return *s
}

func contarPermisosSeleccionados(
	permisos []*model.Permiso,
	seleccionados []*model.ResponsePermisoMe,
) int {
	return contarPermisosGrupo(permisos, seleccionados)
}

func contarPermisosGrupo(
	permisos []*model.Permiso,
	seleccionados []*model.ResponsePermisoMe,
) int {
	total := 0

	for _, permiso := range permisos {
		if hasPermiso(seleccionados, permiso.Metodo) {
			total++
		}
	}

	return total
}

func hasPermiso(permisos []*model.ResponsePermisoMe, metodo string) bool {
	for _, p := range permisos {
		if p.Metodo == metodo {
			return true
		}
	}
	return false
}

type PermisoGrupo struct {
	Nombre   string
	Permisos []*model.Permiso
}

func agruparPermisos(permisos []*model.Permiso) []*PermisoGrupo {
	grupos := make(map[string]*PermisoGrupo)
	var resultado []*PermisoGrupo

	for _, permiso := range permisos {
		grupo, ok := grupos[permiso.Grupo]

		if !ok {
			grupo = &PermisoGrupo{
				Nombre: permiso.Grupo,
			}

			grupos[permiso.Grupo] = grupo
			resultado = append(resultado, grupo)
		}

		grupo.Permisos = append(grupo.Permisos, permiso)
	}

	return resultado
}

func contarMenusSeleccionados(
	menus []*model.Menus,
	seleccionados []*model.Menus,
) int {
	total := 0

	for _, menu := range menus {
		if hasMenu(seleccionados, menu.ID) {
			total++
		}
	}

	return total
}

func hasMenu(menus []*model.Menus, id string) bool {
	for _, m := range menus {
		if m.ID == id {
			return true
		}
	}
	return false
}

type MenuTree struct {
	Menu  *model.Menus
	Hijos []*model.Menus
}

func construirMenuTree(menus []*model.Menus) []*MenuTree {
	padres := make(map[string]*MenuTree)
	var resultado []*MenuTree

	for _, menu := range menus {
		if menu.PadreID == nil {
			item := &MenuTree{
				Menu: menu,
			}

			padres[menu.ID] = item
			resultado = append(resultado, item)
		}
	}

	for _, menu := range menus {
		if menu.PadreID == nil {
			continue
		}

		if padre, ok := padres[*menu.PadreID]; ok {
			padre.Hijos = append(padre.Hijos, menu)
		}
	}

	return resultado
}
