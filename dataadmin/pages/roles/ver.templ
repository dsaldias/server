package roles 

import (
	"fmt"

	"github.com/dsaldias/server/graph_auth/model"
)

templ Ver(rol model.Rol) {
	<div class="space-y-6">
		<div class="rounded-lg border border-border bg-card p-4">
			<div class="mb-4">
				<h3 class="text-sm font-semibold">Datos del rol</h3>
				<p class="text-xs text-muted-foreground">Información general y nivel de jerarquía.</p>
			</div>
			<div class="grid gap-4 sm:grid-cols-2">
				@DatoRol("Nombre", rol.Nombre)
				@DatoRol("Descripción", parseStringx(rol.Descripcion))
				@DatoRol("Jerarquía", fmt.Sprintf("%d", rol.Jerarquia))
				@DatoRol("Fecha de registro", rol.FechaRegistro.Format("02/01/2006 15:04"))
			</div>
		</div>
		@PanelAccesoVer(rol.Permisos, rol.Menus)
	</div>
	<script>
	(function () {
		const tabs = document.querySelectorAll('[data-role-view-tab]')
		const panels = document.querySelectorAll('[data-role-view-panel]')

		tabs.forEach((tab) => {
			tab.addEventListener('click', function () {
				const target = this.dataset.roleViewTab

				tabs.forEach((item) => {
					const active = item.dataset.roleViewTab === target
					item.setAttribute('aria-selected', active ? 'true' : 'false')
					item.classList.toggle('bg-sidebar', active)
					item.classList.toggle('text-sidebar-foreground', active)
					item.classList.toggle('text-muted-foreground', !active)
				})

				panels.forEach((panel) => {
					panel.classList.toggle('hidden', panel.dataset.roleViewPanel !== target)
				})
			})
		})
	})()
	</script>
}

templ DatoRol(label, value string) {
	<div class="rounded-md border border-transparent bg-muted/20 px-3 py-2">
		<div class="text-xs text-muted-foreground">{ label }</div>
		<div class="mt-0.5 text-sm font-medium">{ value }</div>
	</div>
}

templ PanelAccesoVer(
	permisos []*model.ResponsePermisoMe,
	menus []*model.Menus,
) {
	<div class="space-y-3">
		<div class="rounded-lg border border-border bg-card p-1">
			<div class="grid grid-cols-2 gap-1" role="tablist" aria-label="Accesos del rol">
				<button type="button" data-role-view-tab="permisos" aria-selected="true" class="rounded-md bg-sidebar px-3 py-2 text-xs font-semibold text-sidebar-foreground transition-colors">
					Permisos <span class="ml-1 opacity-80">({ len(permisos) })</span>
				</button>
				<button type="button" data-role-view-tab="menus" aria-selected="false" class="rounded-md px-3 py-2 text-xs font-semibold text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
					Menús <span class="ml-1 opacity-80">({ len(menus) })</span>
				</button>
			</div>
		</div>
		@PanelPermisosVer(permisos)
		@PanelMenusVer(menus)
	</div>
}

	templ PanelPermisosVer(permisos []*model.ResponsePermisoMe) {
	<section data-role-view-panel="permisos" class="rounded-lg border border-border bg-card">
		<div class="flex items-center justify-between border-b border-border bg-muted/40 px-4 py-3">
			<div>
				<div>
					<h3 class="text-sm font-semibold">Permisos</h3>
					<p class="text-xs text-muted-foreground">Acciones asignadas a este rol.</p>
				</div>
				<span class="rounded-full bg-accent px-2.5 py-1 text-xs font-semibold text-accent-foreground">
					{ len(permisos) }
				</span>
			</div>
		</div>

		<div class="space-y-2 p-3">
			for _, grupo := range agruparPermisosVer(permisos) {
					<details class="rounded-md border border-border bg-background">
						<summary class="cursor-pointer list-none px-3 py-2.5 transition-colors hover:bg-muted/50">
						<div class="flex items-center">
							<span class="flex-1 text-sm font-medium">
								{ grupo.Nombre }
							</span>

							<span class="rounded-full bg-muted px-2 py-0.5 text-xs text-muted-foreground">
								{ len(grupo.Permisos) }
							</span>
						</div>
					</summary>

						<div class="space-y-1 border-t border-border px-2 py-2">
						for _, permiso := range grupo.Permisos {
								<div class="rounded-md border border-border/50 bg-muted/10 px-3 py-2">
									<div class="text-sm font-medium">
									{ permiso.Nombre }
								</div>

									<div class="mt-0.5 inline-flex rounded bg-muted px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">
									{ permiso.Metodo }
								</div>

								if permiso.Descripcion != nil {
									<div class="text-xs text-muted-foreground mt-1">
										{ *permiso.Descripcion }
									</div>
								}
							</div>
						}
					</div>
				</details>
			}
		</div>
	</section>
}

templ PanelMenusVer(menus []*model.Menus) {
	<section data-role-view-panel="menus" class="hidden rounded-lg border border-border bg-card">
		<div class="flex items-center justify-between border-b border-border bg-muted/40 px-4 py-3">
			<div>
				<h3 class="text-sm font-semibold">Menús</h3>
				<p class="text-xs text-muted-foreground">Opciones visibles para este rol.</p>
			</div>
			<span class="rounded-full bg-accent px-2.5 py-1 text-xs font-semibold text-accent-foreground">
					{ len(menus) }
				</span>
			</div>
		<div class="space-y-2 p-3">
			for _, item := range construirMenuTreeVer(menus) {
				@MenuTreeItemVer(item)
			}
		</div>
	</section>
}

templ MenuTreeItemVer(item *MenuTreeVer) {
	<details class="rounded-md border border-border bg-background">
		<summary class="cursor-pointer list-none px-3 py-2.5 transition-colors hover:bg-muted/50">
			<div class="flex items-center gap-2">
				<div class="flex-1 min-w-0">
					<div class="text-sm font-medium">
						{ item.Menu.Label }
					</div>

					<div class="mt-0.5 inline-flex rounded bg-muted px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">
						{ item.Menu.Path }
					</div>
				</div>

				<div class="rounded-full bg-muted px-2 py-0.5 text-xs text-muted-foreground">
					{ len(item.Hijos) }
				</div>
			</div>
		</summary>

		if len(item.Hijos) > 0 {
			<div class="space-y-1 border-t border-border px-2 py-2">
				for _, hijo := range item.Hijos {
					<div class="rounded-md border border-border/50 bg-muted/10 px-3 py-2 pl-8">
						<div class="text-sm truncate">
							{ hijo.Label }
						</div>

						<div class="mt-0.5 inline-flex rounded bg-muted px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">
							{ hijo.Path }
						</div>
					</div>
				}
			</div>
		}
	</details>
}

type PermisoGrupoVer struct {
	Nombre   string
	Permisos []*model.ResponsePermisoMe
}

func agruparPermisosVer(
	permisos []*model.ResponsePermisoMe,
) []*PermisoGrupoVer {
	grupos := make(map[string]*PermisoGrupoVer)
	var resultado []*PermisoGrupoVer

	for _, permiso := range permisos {
		grupo, ok := grupos[permiso.Grupo]

		if !ok {
			grupo = &PermisoGrupoVer{
				Nombre: permiso.Grupo,
			}

			grupos[permiso.Grupo] = grupo
			resultado = append(resultado, grupo)
		}

		grupo.Permisos = append(grupo.Permisos, permiso)
	}

	return resultado
}

type MenuTreeVer struct {
	Menu  *model.Menus
	Hijos []*model.Menus
}

func construirMenuTreeVer(
	menus []*model.Menus,
) []*MenuTreeVer {
	padres := make(map[string]*MenuTreeVer)
	var resultado []*MenuTreeVer

	for _, menu := range menus {
		if menu.PadreID == nil {
			item := &MenuTreeVer{
				Menu: menu,
			}

			padres[menu.ID] = item
			resultado = append(resultado, item)
		}
	}

	for _, menu := range menus {
		if menu.PadreID == nil {
			continue
		}

		if padre, ok := padres[*menu.PadreID]; ok {
			padre.Hijos = append(padre.Hijos, menu)
		}
	}

	return resultado
}
