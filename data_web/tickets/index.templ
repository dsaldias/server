package tickets

import "github.com/dsaldias/server/data_web/components/button"
import "github.com/dsaldias/server/data_web/components/dialog"
import "github.com/dsaldias/server/data_web/components/icon"
import "github.com/dsaldias/server/data_web/xutility"
import "github.com/dsaldias/server/graph_auth/model"

templ RenderTickets(data TicketsPageData) {
	@dialog.Dialog(dialog.Props{ID: "ticket-create-dialog"}) {
		<div id="tickets-page" class="mx-auto max-w-7xl space-y-6" data-signals:ticketEstado={ ticketSignalString(data.Estado) } data-signals:ticketID="''" data-signals:ticketAction="'create'" data-signals:ticketSaving="false" data-signals:ticketSaved="false">
			@xutility.PageHeader("Tickets", "Administra las solicitudes y conversaciones de soporte.") {
				@button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeButton, Attributes: templ.Attributes{"data-on:click": "@get('/adminx/tickets')"}}) { @icon.RefreshCw(icon.Props{Class: "size-4"}) Refrescar }
				@button.Button(button.Props{Type: button.TypeButton, Attributes: templ.Attributes{"data-slot": "dialog-trigger", "data-base-ui-click-trigger": true, "data-templ-controls": "ticket-create-dialog", "aria-haspopup": "dialog", "aria-expanded": "false", "data-on:click": "$ticketSaving=false; $ticketSaved=false; $ticketAction='create'; $problema=''; document.getElementById('ticket-form-error')?.replaceChildren();"}}) { @icon.Plus(icon.Props{Class: "size-4"}) Nuevo ticket }
			}
			@xutility.FilterBar() {
				<label for="tickets-status" class="text-sm font-medium">Estado</label>
				<select id="tickets-status" class="h-9 rounded-md border border-border/70 bg-background px-3 text-sm" data-bind:ticketEstado data-on:change="@get('/adminx/tickets')"><option value="">Todos</option><option value="abierto">Abierto</option><option value="cliente">Cliente</option><option value="soporte">Soporte</option><option value="cerrado">Cerrado</option></select>
			}
			@TicketsTableRegion(data)
		</div>
		@TicketCreateForm()
	}
}

templ TicketCreateForm() {
	@dialog.Content(dialog.ContentProps{Class: "!bg-card !text-card-foreground shadow-2xl sm:max-w-xl"}) {
		@dialog.Header() { @dialog.Title() { Nuevo ticket } @dialog.Description() { Describe el problema o solicitud que deseas registrar. } }
		<form id="ticket-create-form" class="space-y-5" data-signals:ticketSaving="false" data-signals:ticketSaved="false" data-signals:ticketAction="'create'" data-on:submit__prevent="$ticketSaving=true; $ticketAction='create'; @post('/adminx/tickets?action=create')" data-effect="const button=document.getElementById('ticket-create-submit');if(button){button.disabled=$ticketSaving;button.setAttribute('aria-busy',$ticketSaving?'true':'false');button.textContent=$ticketSaving?'Guardando...':'Crear ticket';}if($ticketSaved){window.templ?.dialog?.close('ticket-create-dialog');$ticketSaved=false;}">
			<label for="ticket-problema" class="space-y-2 text-sm font-medium">Problema o solicitud<textarea id="ticket-problema" name="problema" required class="min-h-32 w-full rounded-md border border-input bg-background px-3 py-2 text-sm" placeholder="Describe lo que necesitas..." data-bind:problema></textarea></label>
			<div id="ticket-form-error"></div>
			@dialog.Footer() { @button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeButton, Attributes: dialog.Close(ctx)}) { Cancelar } @button.Button(button.Props{Type: button.TypeSubmit, ID: "ticket-create-submit"}) { Crear ticket } }
		</form>
	}
}

templ TicketsTableRegion(data TicketsPageData) {
	@xutility.TableRegion("tickets-table-region") {
		if data.Error != "" {
			@xutility.ErrorState(data.Error)
		} else if len(data.Listado) > 0 {
			@xutility.TableCard() {
				<div class="overflow-x-auto"><table class="w-full text-sm"><thead class="border-b border-border/60 bg-muted/40 text-left text-xs uppercase tracking-wide text-muted-foreground"><tr><th class="px-3 py-2 font-medium">Ticket</th><th class="px-3 py-2 font-medium">Usuario</th><th class="px-3 py-2 font-medium">Problema</th><th class="px-3 py-2 font-medium">Estado</th><th class="px-3 py-2 font-medium">Registro</th><th class="px-3 py-2 text-right font-medium">Acciones</th></tr></thead><tbody class="divide-y divide-border/60">
					for _, ticket := range data.Listado {
						<tr class="transition-colors hover:bg-muted/40">
							<td class="whitespace-nowrap px-3 py-2 font-medium">#{ ticket.ID }</td>
							<td class="whitespace-nowrap px-3 py-2">{ ticket.Usuario }</td>
							<td class="max-w-96 truncate px-3 py-2 text-muted-foreground">{ ticket.Problema }</td>
							<td class="px-3 py-2"><span class={ "inline-flex rounded-full px-2 py-1 text-xs font-medium " + ticketStatusClass(ticket.Estado) }>{ ticket.Estado }</span></td>
							<td class="whitespace-nowrap px-3 py-2 text-muted-foreground">{ ticketDate(ticket.FechaRegistro) }</td>
							<td class="px-3 py-2">
								<div class="flex justify-end gap-1">
									@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIconSm, Type: button.TypeButton, Attributes: ticketViewAttributes(ticket.ID)}) { @icon.Eye(icon.Props{Class: "size-4"})<span class="sr-only">Visualizar ticket</span> }
									if ticket.Estado != "cerrado" {
										@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIconSm, Type: button.TypeButton, Attributes: ticketCloseAttributes(ticket.ID)}) { @icon.Check(icon.Props{Class: "size-4"})<span class="sr-only">Cerrar ticket</span> }
									}
								</div>
							</td>
						</tr>
					}
				</tbody></table></div>
			}
		} else {
			@xutility.EmptyState("No hay tickets para mostrar.")
		}
		for _, ticket := range data.Listado {
			@dialog.Dialog(dialog.Props{ID: "ticket-view-" + ticket.ID}) { @TicketView(ticket, data.Detalles[ticket.ID]) }
		}
	}
}

templ TicketView(ticket *model.RespTickets, detail *model.Ticket) {
	@dialog.Content(dialog.ContentProps{Class: "!bg-card !text-card-foreground shadow-2xl sm:max-w-2xl"}) {
		@dialog.Header() { @dialog.Title() { Ticket #{ ticket.ID } } @dialog.Description() { Detalle de la solicitud y sus respuestas. } }
		<div class="max-h-[calc(100vh-12rem)] space-y-4 overflow-y-auto pr-1"><div class="rounded-lg border border-border/60 bg-muted/20 p-4"><p class="text-xs uppercase tracking-wide text-muted-foreground">Problema</p><p class="mt-2 whitespace-pre-wrap text-sm">{ ticket.Problema }</p></div>
			if detail != nil && len(detail.Respuestas) > 0 {
				<div class="space-y-3"><h3 class="text-sm font-semibold">Respuestas</h3>
					for _, respuesta := range detail.Respuestas {
						<div class="rounded-lg border border-border/60 p-3"><p class="whitespace-pre-wrap text-sm">{ respuesta.Respuesta }</p><p class="mt-2 text-xs text-muted-foreground">{ ticketDate(respuesta.FechaRegistro) }</p></div>
					}
				</div>
			} else {
				<p class="text-sm text-muted-foreground">{ ticketText(ticket.Respuesta) }</p>
			}
			if ticket.Estado != "cerrado" {
				<form class="space-y-3" data-signals:ticketID={ ticketSignalString(ticket.ID) } data-signals:ticketAction="'reply'" data-signals:ticketSaving="false" data-on:submit__prevent="$ticketSaving=true; $ticketAction='reply'; @post('/adminx/tickets?action=reply')">
					<label for={ "ticket-response-" + ticket.ID } class="text-sm font-medium">Responder<textarea id={ "ticket-response-" + ticket.ID } name="respuesta" required class="min-h-24 w-full rounded-md border border-input bg-background px-3 py-2 text-sm" data-bind:respuesta placeholder="Escribe una respuesta..."></textarea></label>
					<div id="ticket-response-form-error"></div>
					<button type="submit" class="inline-flex h-9 items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground disabled:pointer-events-none disabled:opacity-50" data-effect="this.disabled=$ticketSaving">Enviar respuesta</button>
				</form>
			}
		</div>
	}
}
