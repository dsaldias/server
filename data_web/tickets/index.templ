package tickets

import "github.com/dsaldias/server/data_web/components/button"
import "github.com/dsaldias/server/data_web/components/dialog"
import "github.com/dsaldias/server/data_web/components/icon"
import "github.com/dsaldias/server/data_web/xutility/marco"

templ RenderTickets(data TicketsPageData) {
	@dialog.Dialog(dialog.Props{ID: "ticket-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "!bg-card !text-card-foreground shadow-2xl sm:max-w-2xl", Attributes: templ.Attributes{"data-on:dialog-close": ticketModalLoadingScript()}}) {
			@dialog.Header() { @dialog.Title() { <span data-ticket-title>Nuevo ticket</span> } @dialog.Description() { <span data-templ-dialog-description>Describe el problema o solicitud que deseas registrar.</span> } }
			@TicketModalLoading()
		}
	}
	@marco.AdminTable(marco.AdminTableProps{Title: "Tickets", Description: "Administra las solicitudes y conversaciones de soporte.", RegionID: "tickets-table-region", Attributes: templ.Attributes{"id": "tickets-page", "data-signals:ticketEstado": ticketSignalString(data.Estado), "data-signals:ticketsLoading": "false"}, HeaderActions: TicketHeaderActions(), Filters: TicketFilters(data)}) { @TicketsTableContent(data) }
}

templ TicketHeaderActions() {
	@button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeButton, Attributes: templ.Attributes{"data-tickets-refresh": true, "data-on:click": ticketsRefreshScript(), "data-effect": ticketsLoadingEffectScript()}}) { <span data-tickets-refresh-icon>@icon.RefreshCw(icon.Props{Class: "size-4"})</span><span data-tickets-refresh-label>Refrescar</span> }
	@button.Button(button.Props{Type: button.TypeButton, Attributes: templ.Attributes{"data-slot": "dialog-trigger", "data-base-ui-click-trigger": true, "data-templ-controls": "ticket-dialog", "aria-haspopup": "dialog", "aria-expanded": "false", "data-ticket-modal-action": true, "data-on:click": ticketModalRequestScript(ADMIN_TICKETS_FORMHTML)}}) { @icon.Plus(icon.Props{Class: "size-4"}) Nuevo ticket }
}

templ TicketFilters(data TicketsPageData) {
	<div class="flex items-center gap-2"><label for="tickets-status" class="whitespace-nowrap text-sm font-medium">Estado</label><select id="tickets-status" class="h-9 rounded-md border border-border/70 bg-background px-3 text-sm" data-bind:ticketEstado data-on:change={ ticketsStatusScript() }><option value="" selected?={ data.Estado == "" }>Todos</option><option value="abierto" selected?={ data.Estado == "abierto" }>Abierto</option><option value="cliente" selected?={ data.Estado == "cliente" }>Cliente</option><option value="soporte" selected?={ data.Estado == "soporte" }>Soporte</option><option value="cerrado" selected?={ data.Estado == "cerrado" }>Cerrado</option></select></div>
}
