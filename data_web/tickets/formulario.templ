package tickets

import "github.com/dsaldias/server/data_web/components/button"
import "github.com/dsaldias/server/data_web/components/dialog"

templ TicketModalLoading() {
	<div id="ticket-dialog-content" class="flex min-h-40 items-center justify-center gap-2 text-sm text-muted-foreground"><span class="size-4 animate-spin rounded-full border-2 border-current border-t-transparent"></span>Cargando, espere...</div>
}

templ TicketCreateForm() {
	<div id="ticket-dialog-content"><form id="ticket-create-form" class="space-y-5" data-signals:ticketProblema="''" data-signals:ticketSaving="false" data-on:submit__prevent={ ticketFormSubmitScript() } data-effect="const button=document.getElementById('ticket-create-submit');if(button){button.disabled=$ticketSaving;button.setAttribute('aria-busy',$ticketSaving?'true':'false');button.textContent=$ticketSaving?'Guardando...':'Crear ticket';}">
		<label for="ticket-problema" class="space-y-2 text-sm font-medium">Problema o solicitud<textarea id="ticket-problema" name="problema" required class="min-h-32 w-full rounded-md border border-input bg-background px-3 py-2 text-sm" placeholder="Describe lo que necesitas..." data-bind:ticketProblema></textarea></label>
		<div id="ticket-form-error"></div>
		@dialog.Footer() { @button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeButton, Attributes: dialog.Close(ctx)}) { Cancelar } @button.Button(button.Props{Type: button.TypeSubmit, ID: "ticket-create-submit"}) { Crear ticket } }
	</form></div>
}
