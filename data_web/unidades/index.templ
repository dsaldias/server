package unidades

import "github.com/dsaldias/server/data_web/components/button"
import "github.com/dsaldias/server/data_web/components/dialog"
import "github.com/dsaldias/server/data_web/components/icon"
import "github.com/dsaldias/server/data_web/components/input"
import "github.com/dsaldias/server/data_web/xutility/marco"

templ RenderUnidades(data UnidadesPageData) {
	@dialog.Dialog(dialog.Props{ID: "unidad-dialog"}) {
		@UnidadModalLoading()
		@marco.AdminTable(marco.AdminTableProps{Title: "Unidades", Description: "Administra las unidades disponibles en el sistema.", RegionID: "unidades-table-region", Attributes: templ.Attributes{"id": "unidades-page", "data-signals:pagina": unidadSignalInt(data.Pagina), "data-signals:size": unidadSignalInt(data.Size), "data-signals:unidadBusqueda": unidadSignalString(data.Nombre), "data-signals:unidadesLoading": "false"}, HeaderActions: UnidadHeaderActions(), Filters: UnidadFilters(data)}) {
			@UnidadesTableContent(data)
		}
	}
}

templ UnidadHeaderActions() {
	@button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeButton, Attributes: templ.Attributes{"data-unidades-refresh": true, "data-on:click": unidadRefreshScript(), "data-effect": unidadLoadingButtonEffectScript()}}) { <span data-unidades-refresh-icon>@icon.RefreshCw(icon.Props{Class: "size-4"})</span><span data-unidades-refresh-label>Refrescar</span> }
	@button.Button(button.Props{Type: button.TypeButton, Attributes: templ.Attributes{"tabindex": "0", "data-slot": "dialog-trigger", "data-base-ui-click-trigger": true, "data-templ-controls": "unidad-dialog", "aria-haspopup": "dialog", "aria-expanded": "false", "data-unidad-modal-action": true, "data-on:click": unidadModalRequestScript(ADMIN_UNIDADES_FORMHTML)}}) { @icon.Plus(icon.Props{Class: "size-4"}) Nueva unidad }
}

templ UnidadFilters(data UnidadesPageData) {
	<div class="flex w-full flex-col gap-2 sm:flex-row sm:items-end">
		<div class="w-full sm:max-w-md"><label for="unidades-search" class="mb-2 block text-sm font-medium">Buscar por nombre</label><div class="flex gap-2">@input.Input(input.Props{ID: "unidades-search", Type: "search", Value: data.Nombre, Placeholder: "Ej. Unidad central", Class: "h-9", Attributes: templ.Attributes{"data-bind:unidadBusqueda": true, "data-on:keydown": unidadSearchKeydownScript()}})<button type="button" class="inline-flex h-9 shrink-0 items-center justify-center rounded-md border border-border/70 px-3 text-sm hover:bg-muted disabled:opacity-50" data-on:click={ unidadSearchScript() } data-effect="this.disabled=$unidadesLoading"><span data-unidades-search-icon>@icon.Search(icon.Props{Class: "size-4"})</span><span data-unidades-search-label class="sr-only">Buscar</span></button></div></div>
		<div class="flex items-center gap-2"><label for="unidades-page-size" class="whitespace-nowrap text-sm text-muted-foreground">Mostrar</label><select id="unidades-page-size" class="h-9 rounded-md border border-border/70 bg-background px-3 text-sm" data-bind:size data-on:change={ unidadPageSizeScript() }><option value="10">10</option><option value="20">20</option><option value="50">50</option></select><span class="text-sm text-muted-foreground">registros</span></div>
	</div>
}
