package unidades

import "github.com/dsaldias/server/data_web/components/button"
import "github.com/dsaldias/server/data_web/components/icon"
import "github.com/dsaldias/server/data_web/xutility/marco"

templ UnidadesTableRegion(data UnidadesPageData) {
	@marco.TableRegion("unidades-table-region") { @UnidadesTableContent(data) }
}

templ UnidadesTableContent(data UnidadesPageData) {
	if data.Error != "" {
		@marco.ErrorState(data.Error)
	} else if data.Listado != nil && len(data.Listado.Datos) > 0 {
		@marco.TableCard() {
			<div class="overflow-x-auto"><table class="w-full text-sm"><thead class="border-b border-border/60 bg-muted/40 text-left text-xs uppercase tracking-wide text-muted-foreground"><tr><th class="px-3 py-2 font-medium">Nombre</th><th class="px-3 py-2 font-medium">Descripción</th><th class="px-3 py-2 font-medium">Orden</th><th class="px-3 py-2 font-medium">Latitud</th><th class="px-3 py-2 font-medium">Longitud</th><th class="px-3 py-2 font-medium">Registro</th><th class="px-3 py-2 text-right font-medium">Acciones</th></tr></thead><tbody class="divide-y divide-border/60">
				for _, unidad := range data.Listado.Datos {
					if unidad != nil {
						<tr class="transition-colors hover:bg-muted/40"><td class="whitespace-nowrap px-3 py-2 font-medium">{ unidad.Nombre }</td><td class="max-w-64 truncate px-3 py-2 text-muted-foreground">{ unidadText(unidad.Descripcion) }</td><td class="px-3 py-2 text-muted-foreground">{ unidadStatus(unidad.Orden) }</td><td class="px-3 py-2 text-muted-foreground">{ unidadFloat(unidad.Latitud) }</td><td class="px-3 py-2 text-muted-foreground">{ unidadFloat(unidad.Longitud) }</td><td class="whitespace-nowrap px-3 py-2 text-muted-foreground">{ unidadDate(unidad.FechaRegistro) }</td><td class="px-3 py-2"><div class="flex justify-end gap-1">
							@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIconSm, Type: button.TypeButton, Attributes: templ.Attributes{"tabindex": "0", "data-slot": "dialog-trigger", "data-base-ui-click-trigger": true, "data-templ-controls": "unidad-dialog", "aria-haspopup": "dialog", "aria-expanded": "false", "data-unidad-modal-action": true, "data-unidad-id": unidad.ID, "data-on:click": unidadModalRequestWithIDScript(ADMIN_UNIDADES_VERHTML)}}) { @icon.Eye(icon.Props{Class: "size-4"})<span class="sr-only">Visualizar unidad</span> }
							@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIconSm, Type: button.TypeButton, Attributes: templ.Attributes{"tabindex": "0", "data-slot": "dialog-trigger", "data-base-ui-click-trigger": true, "data-templ-controls": "unidad-dialog", "aria-haspopup": "dialog", "aria-expanded": "false", "data-unidad-modal-action": true, "data-unidad-id": unidad.ID, "data-on:click": unidadModalRequestWithIDScript(ADMIN_UNIDADES_EDITHTML)}}) { @icon.Pencil(icon.Props{Class: "size-4"})<span class="sr-only">Editar unidad</span> }
						</div></td></tr>
					}
				}
			</tbody></table></div>
			@marco.Pagination(unidadPageSummary(data.Listado), unidadPageLabel(data.Listado), !unidadCanPrevious(data.Listado), !unidadCanNext(data.Listado), templ.Attributes{"data-on:click": unidadPageClick(data.Pagina - 1)}, templ.Attributes{"data-on:click": unidadPageClick(data.Pagina + 1)})
		}
	} else {
		@marco.EmptyState("No hay unidades registradas.")
	}
}
