package roles

import "github.com/dsaldias/server/data_web/components/button"
import "github.com/dsaldias/server/data_web/components/icon"
import "github.com/dsaldias/server/data_web/xutility/marco"

templ RolesTableRegion(data RolesPageData) {
	@marco.TableRegion("roles-table-region") {
		@RolesTableContent(data)
	}
}

templ RolesTableContent(data RolesPageData) {
	if data.Error != "" {
		@marco.ErrorState(data.Error)
	} else if data.Listado != nil && len(data.Listado.Datos) > 0 {
		@marco.TableCard() {
			<div class="overflow-x-auto"><table class="w-full text-sm">
				<thead class="border-b border-border/60 bg-muted/40 text-left text-xs uppercase tracking-wide text-muted-foreground"><tr><th class="px-3 py-2 font-medium">Nombre</th><th class="px-3 py-2 font-medium">Descripción</th><th class="px-3 py-2 font-medium">Jerarquía</th><th class="px-3 py-2 font-medium">Menús</th><th class="px-3 py-2 font-medium">Permisos</th><th class="px-3 py-2 font-medium">Usuarios</th><th class="px-3 py-2 font-medium">Registro</th><th class="px-3 py-2 text-right font-medium">Acciones</th></tr></thead>
				<tbody class="divide-y divide-border/60">
					for _, role := range data.Listado.Datos {
						if role != nil {
							<tr class="transition-colors hover:bg-muted/40"><td class="whitespace-nowrap px-3 py-2 font-medium">{ role.Nombre }</td><td class="max-w-64 truncate px-3 py-2 text-muted-foreground">{ roleText(role.Descripcion) }</td><td class="px-3 py-2 text-muted-foreground">{ roleStatus(role.Jerarquia) }</td><td class="px-3 py-2 text-muted-foreground">{ roleStatus(role.Menus) }</td><td class="px-3 py-2 text-muted-foreground">{ roleStatus(role.Permisos) }</td><td class="px-3 py-2 text-muted-foreground">{ roleStatus(role.Usuarios) }</td><td class="whitespace-nowrap px-3 py-2 text-muted-foreground">{ roleDate(role.FechaRegistro) }</td><td class="px-3 py-2"><div class="flex justify-end gap-1">
								@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIconSm, Type: button.TypeButton, Attributes: templ.Attributes{"tabindex": "0", "data-slot": "dialog-trigger", "data-base-ui-click-trigger": true, "data-templ-controls": "rol-dialog", "aria-haspopup": "dialog", "aria-expanded": "false", "data-rol-modal-action": true, "data-role-id": role.ID, "data-on:click": roleModalRequestWithIDScript(ADMIN_ROLES_VERHTML)}}) { @icon.Eye(icon.Props{Class: "size-4"})<span class="sr-only">Visualizar rol</span> }
								@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIconSm, Type: button.TypeButton, Attributes: templ.Attributes{"tabindex": "0", "data-slot": "dialog-trigger", "data-base-ui-click-trigger": true, "data-templ-controls": "rol-dialog", "aria-haspopup": "dialog", "aria-expanded": "false", "data-rol-modal-action": true, "data-role-id": role.ID, "data-on:click": roleModalRequestWithIDScript(ADMIN_ROLES_EDITHTML)}}) { @icon.Pencil(icon.Props{Class: "size-4"})<span class="sr-only">Editar rol</span> }
							</div></td></tr>
						}
					}
				</tbody>
			</table></div>
			@marco.Pagination(rolePageSummary(data.Listado), rolePageLabel(data.Listado), !roleCanPrevious(data.Listado), !roleCanNext(data.Listado), templ.Attributes{"data-on:click": rolePageClick(data.Pagina - 1)}, templ.Attributes{"data-on:click": rolePageClick(data.Pagina + 1)})
		}
	} else {
		@marco.EmptyState("No hay roles registrados.")
	}
}
