package roles

import "github.com/dsaldias/server/data_web/components/button"
import "github.com/dsaldias/server/data_web/components/combobox"
import "github.com/dsaldias/server/data_web/components/dialog"
import "github.com/dsaldias/server/data_web/components/field"
import "github.com/dsaldias/server/data_web/components/icon"
import "github.com/dsaldias/server/data_web/components/input"
import "github.com/dsaldias/server/graph_auth/model"

templ RoleModalLoading() {
	@dialog.Content(dialog.ContentProps{Class: "!bg-card !text-card-foreground shadow-2xl sm:max-w-3xl", Attributes: templ.Attributes{"data-on:dialog-close": roleModalLoading()}}) {
		@dialog.Header() { @dialog.Title() { <span data-rol-title>Rol</span> } @dialog.Description() { Gestiona la información y asignaciones del rol. } }
		<div id="rol-dialog-content" class="flex min-h-40 items-center justify-center gap-2 text-sm text-muted-foreground" aria-live="polite"><span class="size-4 animate-spin rounded-full border-2 border-current border-t-transparent"></span>Cargando, espere...</div>
	}
}

templ RoleModalError(message string) {
	<div id="rol-dialog-content" class="rounded-md border border-destructive/30 bg-destructive/10 px-3 py-2 text-sm text-destructive">{ message }</div>
}

templ RoleForm(permisos []*model.Permiso, menus []*model.Menus, role *model.Rol) {
	<div id="rol-dialog-content">
		<form id="rol-form" class="max-h-[calc(100vh-10rem)] space-y-5 overflow-y-auto pr-1" data-signals:rolMode={ roleSignalString(roleFormMode(role)) } data-signals:rolID={ roleSignalString(roleFormID(role)) } data-signals:nombre={ roleSignalString(roleFormValue(role, "nombre")) } data-signals:descripcion={ roleSignalString(roleFormValue(role, "descripcion")) } data-signals:jerarquia={ roleFormInt(role) } data-signals:permisos={ roleFormIDs(role, false) } data-signals:menus={ roleFormIDs(role, true) } data-signals:rolSaving="false" data-signals:rolSaved="false" data-effect="const button=document.getElementById('rol-submit');if(button){button.disabled=$rolSaving;button.setAttribute('aria-busy',$rolSaving?'true':'false');button.textContent=$rolSaving?'Guardando...':'Guardar rol';}if($rolSaved){window.templ?.dialog?.close('rol-dialog');$rolSaved=false;}" data-on:submit__prevent={ roleFormSubmitScript(role) }>
			<input type="hidden" data-bind:rolID />
			<div class="grid gap-4 sm:grid-cols-2">
				@field.Field() { @field.Label(field.LabelProps{For: "rol-nombre"}) { Nombre } @input.Input(input.Props{ID: "rol-nombre", Placeholder: "Nombre del rol", Required: true, Value: roleFormValue(role, "nombre"), Class: "h-9", Attributes: templ.Attributes{"data-bind:nombre": true}}) }
				@field.Field() { @field.Label(field.LabelProps{For: "rol-jerarquia"}) { Jerarquía } <input id="rol-jerarquia" type="number" min="0" value={ roleFormInt(role) } class="flex h-9 w-full rounded-md border border-input bg-background px-3 text-sm" data-bind:jerarquia /> }
			</div>
			@field.Field() { @field.Label(field.LabelProps{For: "rol-descripcion"}) { Descripción } <textarea id="rol-descripcion" maxlength="100" class="min-h-20 w-full rounded-md border border-input bg-background px-3 py-2 text-sm" placeholder="Descripción del rol" data-bind:descripcion>{ roleFormValue(role, "descripcion") }</textarea> }
			<div class="grid gap-4 sm:grid-cols-2">
				<div class="space-y-2 rounded-lg border border-border/60 bg-muted/10 p-3"><div><p class="text-sm font-medium">Permisos</p><p class="text-xs text-muted-foreground">Busca y selecciona uno o varios permisos.</p></div><div data-on:combobox-change="$permisos = evt.detail.values">
					@combobox.Combobox(combobox.Props{ID: "rol-permisos", Multiple: true, DefaultValues: roleFormSelectionIDs(role, false), Items: rolePermissionItems(permisos)}) {
						@combobox.Chips() { @combobox.Value() @combobox.ChipsInput(combobox.ChipsInputProps{Placeholder: "Buscar permisos..."}) }
						@combobox.Content(combobox.ContentProps{Class: "!bg-popover !text-popover-foreground !border !border-border shadow-lg"}) {
							@combobox.Empty() { No hay permisos disponibles. }
							@combobox.List() {
								for _, permission := range permisos {
									if permission != nil {
										@combobox.Item(combobox.ItemProps{Value: permission.Metodo, Label: permission.Nombre}) { { permission.Nombre } }
									}
								}
							}
						}
					}
				</div><p class="text-xs text-muted-foreground">Los permisos seleccionados aparecerán como etiquetas.</p></div>
				<div class="space-y-2 rounded-lg border border-border/60 bg-muted/10 p-3"><div><p class="text-sm font-medium">Menús</p><p class="text-xs text-muted-foreground">Busca y selecciona los menús que podrá utilizar este rol.</p></div><div data-on:combobox-change="$menus = evt.detail.values">
					@combobox.Combobox(combobox.Props{ID: "rol-menus", Multiple: true, DefaultValues: roleFormSelectionIDs(role, true), Items: roleMenuItems(menus)}) {
						@combobox.Chips() { @combobox.Value() @combobox.ChipsInput(combobox.ChipsInputProps{Placeholder: "Buscar menús..."}) }
						@combobox.Content(combobox.ContentProps{Class: "!bg-popover !text-popover-foreground !border !border-border shadow-lg"}) {
							@combobox.Empty() { No hay menús disponibles. }
							@combobox.List() {
								for _, menu := range menus {
									if menu != nil {
										@combobox.Item(combobox.ItemProps{Value: menu.ID, Label: menu.Label}) {
											if menu.PadreID != nil {
												<div class="flex min-w-0 items-center gap-2 pl-3">@icon.CornerDownRight(icon.Props{Class: "size-3.5 shrink-0 text-muted-foreground"})<span class="min-w-0 truncate">{ menu.Label }</span><span class="ml-auto truncate text-xs text-muted-foreground">{ roleMenuParentName(menu, menus) }</span></div>
											} else {
												<div class="flex min-w-0 items-center gap-2 font-medium">@icon.Folder(icon.Props{Class: "size-3.5 shrink-0 text-muted-foreground"})<span class="min-w-0 truncate">{ menu.Label }</span></div>
											}
										}
									}
								}
							}
						}
					}
				</div><p class="text-xs text-muted-foreground">Los menús seleccionados aparecerán como etiquetas.</p></div>
			</div>
			<div id="rol-form-error"></div>
			@dialog.Footer() { @button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeButton, Attributes: dialog.Close(ctx)}) { Cancelar } @button.Button(button.Props{Type: button.TypeSubmit, ID: "rol-submit"}) { Guardar rol } }
		</form>
	</div>
}
