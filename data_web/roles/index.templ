package roles

import "github.com/dsaldias/server/data_web/components/button"
import "github.com/dsaldias/server/data_web/components/dialog"
import "github.com/dsaldias/server/data_web/components/icon"
import "github.com/dsaldias/server/data_web/xutility"

templ RenderRoles(data RolesPageData) {
	@dialog.Dialog(dialog.Props{ID: "rol-dialog"}) {
		<div id="roles-page" class="mx-auto max-w-7xl space-y-6" data-signals:pagina={ roleSignalInt(data.Pagina) } data-signals:size={ roleSignalInt(data.Size) }>
			@xutility.PageHeader("Roles", "Administra los roles y sus permisos de acceso.") {
				@button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeButton, Attributes: templ.Attributes{"data-on:click": "$pagina=1; @get('/adminx/roles')"}}) { @icon.RefreshCw(icon.Props{Class: "size-4"}) Refrescar }
				@button.Button(button.Props{Type: button.TypeButton, Attributes: templ.Attributes{"data-slot": "dialog-trigger", "data-base-ui-click-trigger": true, "data-templ-controls": "rol-dialog", "aria-haspopup": "dialog", "aria-expanded": "false", "data-on:click": roleCreateResetScript()}}) { @icon.Plus(icon.Props{Class: "size-4"}) Nuevo rol }
			}
			<div class="flex items-center justify-end rounded-xl border border-border/60 bg-card p-4 shadow-sm">
				<div class="flex items-center gap-2">
					<label for="roles-page-size" class="whitespace-nowrap text-sm text-muted-foreground">Mostrar</label>
					<select id="roles-page-size" class="h-9 rounded-md border border-border/70 bg-background px-3 text-sm" data-bind:size data-on:change="$pagina=1; @get('/adminx/roles')"><option value="10">10</option><option value="20">20</option><option value="50">50</option></select>
					<span class="text-sm text-muted-foreground">registros</span>
				</div>
			</div>
			@RolesTableRegion(data)
			@RoleViewDialogs(data)
		</div>
		@RoleForm(data.Permisos, data.Menus)
	}
}

templ RolesTableRegion(data RolesPageData) {
	@xutility.TableRegion("roles-table-region") {
		if data.Error != "" {
			@xutility.ErrorState(data.Error)
		} else if data.Listado != nil && len(data.Listado.Datos) > 0 {
			@xutility.TableCard() {
				<div class="overflow-x-auto"><table class="w-full text-sm">
					<thead class="border-b border-border/60 bg-muted/40 text-left text-xs uppercase tracking-wide text-muted-foreground"><tr><th class="px-3 py-2 font-medium">Nombre</th><th class="px-3 py-2 font-medium">Descripción</th><th class="px-3 py-2 font-medium">Jerarquía</th><th class="px-3 py-2 font-medium">Menús</th><th class="px-3 py-2 font-medium">Permisos</th><th class="px-3 py-2 font-medium">Usuarios</th><th class="px-3 py-2 font-medium">Registro</th><th class="px-3 py-2 text-right font-medium">Acciones</th></tr></thead>
					<tbody class="divide-y divide-border/60">
						for _, role := range data.Listado.Datos {
							if role != nil {
								<tr class="transition-colors hover:bg-muted/40"><td class="whitespace-nowrap px-3 py-2 font-medium">{ role.Nombre }</td><td class="max-w-64 truncate px-3 py-2 text-muted-foreground">{ roleText(role.Descripcion) }</td><td class="px-3 py-2 text-muted-foreground">{ roleStatus(role.Jerarquia) }</td><td class="px-3 py-2 text-muted-foreground">{ roleStatus(role.Menus) }</td><td class="px-3 py-2 text-muted-foreground">{ roleStatus(role.Permisos) }</td><td class="px-3 py-2 text-muted-foreground">{ roleStatus(role.Usuarios) }</td><td class="whitespace-nowrap px-3 py-2 text-muted-foreground">{ roleDate(role.FechaRegistro) }</td><td class="px-3 py-2"><div class="flex justify-end gap-1">
									@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIconSm, Type: button.TypeButton, Attributes: dialog.TriggerFor("rol-view-" + role.ID)}) { @icon.Eye(icon.Props{Class: "size-4"})<span class="sr-only">Visualizar rol</span> }
									if detail, ok := data.Detalles[role.ID]; ok {
										@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIconSm, Type: button.TypeButton, Attributes: roleEditAttributes(detail)}) { @icon.Pencil(icon.Props{Class: "size-4"})<span class="sr-only">Editar rol</span> }
									}
								</div></td></tr>
							}
						}
					</tbody>
				</table></div>
				@xutility.Pagination(rolePageSummary(data.Listado), rolePageLabel(data.Listado), !roleCanPrevious(data.Listado), !roleCanNext(data.Listado), templ.Attributes{"data-on:click": rolePageClick(data.Pagina - 1)}, templ.Attributes{"data-on:click": rolePageClick(data.Pagina + 1)})
			}
		} else {
			@xutility.EmptyState("No hay roles registrados.")
		}
	}
}

templ RoleViewDialogs(data RolesPageData) {
	if data.Listado != nil {
		for _, role := range data.Listado.Datos {
			if detail, ok := data.Detalles[role.ID]; ok {
				@dialog.Dialog(dialog.Props{ID: "rol-view-" + role.ID}) {
					@RoleView(detail)
				}
			}
		}
	}
}
