package roles

import "github.com/dsaldias/server/data_web/components/button"
import "github.com/dsaldias/server/data_web/components/dialog"
import "github.com/dsaldias/server/data_web/components/icon"
import "github.com/dsaldias/server/data_web/xutility/marco"

templ RenderRoles(data RolesPageData) {
	@dialog.Dialog(dialog.Props{ID: "rol-dialog"}) {
		@RoleModalLoading()
		@marco.AdminTable(marco.AdminTableProps{
			Title: "Roles",
			Description: "Administra los roles y sus permisos de acceso.",
			RegionID: "roles-table-region",
			Attributes: templ.Attributes{
				"id": "roles-page",
				"data-signals:pagina": roleSignalInt(data.Pagina),
				"data-signals:size": roleSignalInt(data.Size),
				"data-signals:rolesLoading": "false",
			},
			HeaderActions: RoleHeaderActions(),
			Filters: RoleFilters(),
		}) {
			@RolesTableContent(data)
		}
	}
}

templ RoleHeaderActions() {
	@button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeButton, Attributes: templ.Attributes{"data-roles-refresh": true, "data-on:click": roleRefreshScript(), "data-effect": roleLoadingButtonEffectScript()}}) {
		<span data-roles-refresh-icon>@icon.RefreshCw(icon.Props{Class: "size-4"})</span><span data-roles-refresh-label>Refrescar</span>
	}
	@button.Button(button.Props{Type: button.TypeButton, Attributes: templ.Attributes{"tabindex": "0", "data-slot": "dialog-trigger", "data-base-ui-click-trigger": true, "data-templ-controls": "rol-dialog", "aria-haspopup": "dialog", "aria-expanded": "false", "data-rol-modal-action": true, "data-on:click": roleModalRequestScript(ADMIN_ROLES_FORMHTML)}}) {
		@icon.Plus(icon.Props{Class: "size-4"}) Nuevo rol
	}
}

templ RoleFilters() {
	<div class="flex items-center gap-2">
		<label for="roles-page-size" class="whitespace-nowrap text-sm text-muted-foreground">Mostrar</label>
		<select id="roles-page-size" class="h-9 rounded-md border border-border/70 bg-background px-3 text-sm" data-bind:size data-on:change={ rolePageSizeScript() }>
			<option value="10">10</option>
			<option value="20">20</option>
			<option value="50">50</option>
		</select>
		<span class="text-sm text-muted-foreground">registros</span>
	</div>
}
