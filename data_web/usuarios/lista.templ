package usuarios

import "github.com/dsaldias/server/data_web/components/button"
import "github.com/dsaldias/server/data_web/components/icon"
import "github.com/dsaldias/server/data_web/xutility/marco"

templ UsuariosTableRegion(data UsuariosPageData) {
	@marco.TableRegion("usuarios-table-region") {
		@UsuariosTableContent(data)
	}
}

templ UsuariosTableContent(data UsuariosPageData) {
	if data.Error != "" {
		@marco.ErrorState(data.Error)
	} else if data.Listado != nil {
		@marco.TableCard() {
				<div class="overflow-x-auto">
					<table class="w-full text-sm">
						<thead class="border-b border-border/60 bg-muted/40 text-left text-xs uppercase tracking-wide text-muted-foreground">
							<tr><th class="px-3 py-2 font-medium">Usuario</th><th class="px-3 py-2 font-medium">Username</th><th class="px-3 py-2 font-medium">Correo</th><th class="px-3 py-2 font-medium">Documento</th><th class="px-3 py-2 font-medium">Estado</th><th class="px-3 py-2 font-medium">Último acceso</th><th class="px-3 py-2 text-right font-medium">Acciones</th></tr>
						</thead>
						<tbody class="divide-y divide-border/60">
							for _, user := range data.Listado.Datos {
								<tr class="transition-colors hover:bg-muted/40">
									<td class="whitespace-nowrap px-3 py-2 font-medium">{ user.Nombres + " " + user.Apellido1 }</td>
									<td class="px-3 py-2 text-muted-foreground">{ user.Username }</td>
									<td class="px-3 py-2 text-muted-foreground">{ optionalString(user.Correo) }</td>
									<td class="px-3 py-2 text-muted-foreground">{ optionalString(user.Documento) }</td>
									<td class="px-3 py-2"><span class={ usuarioStatusClass(user.Estado) }>{ usuarioStatusLabel(user.Estado) }</span></td>
									<td class="whitespace-nowrap px-3 py-2 text-muted-foreground">{ usuarioLastLogin(user.LastLogin) }</td>
									<td class="px-3 py-2"><div class="flex justify-end gap-1">
										@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIconSm, Type: button.TypeButton, Attributes: templ.Attributes{"tabindex": "0", "type": "button", "data-slot": "dialog-trigger", "data-base-ui-click-trigger": true, "data-templ-controls": "usuario-dialog", "aria-haspopup": "dialog", "aria-expanded": "false", "data-usuario-modal-action": true, "data-usuario-id": user.ID, "data-on:click": usuarioModalRequestWithIDScript(ADMIN_USUARIOS_VERHTML)}}) { @icon.Eye(icon.Props{Class: "size-4"})<span class="sr-only">Visualizar usuario</span> }
										@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIconSm, Type: button.TypeButton, Attributes: templ.Attributes{"tabindex": "0", "type": "button", "data-slot": "dialog-trigger", "data-base-ui-click-trigger": true, "data-templ-controls": "usuario-dialog", "aria-haspopup": "dialog", "aria-expanded": "false", "data-usuario-modal-action": true, "data-usuario-id": user.ID, "data-on:click": usuarioModalRequestWithIDScript(ADMIN_USUARIOS_EDITHTML)}}) { @icon.Pencil(icon.Props{Class: "size-4"})<span class="sr-only">Editar usuario</span> }
									</div></td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			@marco.Pagination(usuarioPaginationSummary(data.Listado), usuarioPageLabel(data.Listado), !usuarioCanPrevious(data.Listado), !usuarioCanNext(data.Listado), templ.Attributes{"data-on:click": usuarioPageClick(data.Pagina - 1)}, templ.Attributes{"data-on:click": usuarioPageClick(data.Pagina + 1)})
		}
	}
}
