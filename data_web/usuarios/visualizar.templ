package usuarios

import "github.com/dsaldias/server/data_web/components/dialog"
import "github.com/dsaldias/server/data_web/xutility"
import "github.com/dsaldias/server/graph_auth/model"

templ Visualizar(user *model.ResponseUsuario) {
	@dialog.Content(dialog.ContentProps{Class: "!bg-card !text-card-foreground shadow-2xl sm:max-w-3xl"}) {
		@dialog.Header() {
			@dialog.Title() { Visualizar usuario }
			@dialog.Description() { Consulta la información registrada del usuario. }
		}
		<div class="max-h-[calc(100vh-12rem)] space-y-5 overflow-y-auto pr-1">
		<div class="grid gap-4 sm:grid-cols-2">
			@xutility.ReadField("Nombres", user.Nombres)
			@xutility.ReadField("Primer apellido", user.Apellido1)
			@xutility.ReadField("Segundo apellido", optionalString(user.Apellido2))
			@xutility.ReadField("Usuario", user.Username)
			@xutility.ReadField("Documento", optionalString(user.Documento))
			@xutility.ReadField("Celular", optionalString(user.Celular))
			@xutility.ReadField("Correo", optionalString(user.Correo))
			@xutility.ReadField("Sexo", optionalString(user.Sexo))
			@xutility.ReadField("Dirección", optionalString(user.Direccion))
			@xutility.ReadField("Estado", usuarioStatusLabel(user.Estado))
			@xutility.ReadField("Último acceso", usuarioLastLogin(user.LastLogin))
			@xutility.ReadField("Fecha de registro", usuarioTime(user.FechaRegistro))
			@xutility.ReadField("Última actualización", usuarioTime(user.FechaUpdate))
			@xutility.ReadField("OAuth ID", optionalString(user.OauthID))
			@xutility.ReadField("Foto URL", optionalString(user.FotoURL))
			@xutility.ReadField("Latitud", usuarioFloat(user.Latitud))
			@xutility.ReadField("Longitud", usuarioFloat(user.Longitud))
			@xutility.ReadField("Conexiones", usuarioInt(user.Conexiones))
		</div>

		@xutility.ReadSection("Roles y unidades") {
			if len(user.Roles) == 0 {
				@xutility.EmptyState("Sin roles asignados.")
			} else {
				<div class="space-y-2">
					for _, role := range user.Roles {
						<div class="grid gap-2 rounded-md border border-border/60 bg-muted/20 px-3 py-2 sm:grid-cols-2">
							@xutility.ReadField("Rol", role.RolName)
							@xutility.ReadField("Unidad", role.UnidadName)
						</div>
					}
				</div>
			}
		}

		@xutility.ReadSection("Permisos directos") {
			if len(user.PermisosSueltos) == 0 {
				@xutility.EmptyState("Sin permisos directos.")
			} else {
				<div class="grid gap-2 sm:grid-cols-2">
					for _, permission := range user.PermisosSueltos {
						@xutility.ReadField(permission.Nombre, permission.Metodo)
					}
				</div>
			}
		}

		@xutility.ReadSection("Menús directos") {
			if len(user.MenusSueltos) == 0 {
				@xutility.EmptyState("Sin menús directos.")
			} else {
				<div class="grid gap-2 sm:grid-cols-2">
					for _, menu := range user.MenusSueltos {
						@xutility.ReadField(menu.Label, menu.Path)
					}
				</div>
			}
		}
		</div>
	}
}
