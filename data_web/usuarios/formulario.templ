package usuarios 

import "github.com/dsaldias/server/data_web/components/button"
import "github.com/dsaldias/server/data_web/components/dialog"
import "github.com/dsaldias/server/data_web/components/field"
import "github.com/dsaldias/server/data_web/components/input"
import "github.com/dsaldias/server/graph_auth/model"

templ UsuarioModalLoading() {
	@dialog.Content(dialog.ContentProps{Class: "!bg-card !text-card-foreground shadow-2xl sm:max-w-3xl", Attributes: templ.Attributes{"data-on:dialog-close": usuarioDialogCleanupScript()}}) {
		@dialog.Header() {
			@dialog.Title() { <span data-usuario-title>Usuario</span> }
		}
		<div id="usuario-dialog-body" class="max-h-[calc(100vh-10rem)] overflow-x-hidden overflow-y-auto overscroll-contain">
			<div id="usuario-dialog-content" class="flex min-h-40 items-center justify-center gap-2 text-sm text-muted-foreground" aria-live="polite">
				<span class="size-4 animate-spin rounded-full border-2 border-current border-t-transparent"></span>
				Cargando, espere...
			</div>
		</div>
	}
}

templ UsuarioModalError(message string) {
	<div id="usuario-dialog-content" class="rounded-md border border-destructive/30 bg-destructive/10 px-3 py-2 text-sm text-destructive">{ message }</div>
}

templ Formulario(roles []*model.ResponseRoles, unidades []*model.Unidad, user *model.ResponseUsuario) {
	<div id="usuario-dialog-content">
		<form id="usuario-form" data-usuario-form="shared" class="space-y-5" data-signals:nombres={ usuarioSignalString(usuarioFormValue(user, "nombres")) } data-signals:apellido1={ usuarioSignalString(usuarioFormValue(user, "apellido1")) } data-signals:apellido2={ usuarioSignalString(usuarioFormValue(user, "apellido2")) } data-signals:documento={ usuarioSignalString(usuarioFormValue(user, "documento")) } data-signals:celular={ usuarioSignalString(usuarioFormValue(user, "celular")) } data-signals:correo={ usuarioSignalString(usuarioFormValue(user, "correo")) } data-signals:sexo={ usuarioSignalString(usuarioFormValue(user, "sexo")) } data-signals:direccion={ usuarioSignalString(usuarioFormValue(user, "direccion")) } data-signals:username={ usuarioSignalString(usuarioFormValue(user, "username")) } data-signals:password="''" data-signals:foto64="''" data-signals:usuarioMode={ usuarioSignalString(usuarioFormMode(user)) } data-signals:usuarioID={ usuarioSignalString(usuarioFormID(user)) } data-signals:rolesJson={ usuarioSignalString(usuarioFormRolesJSON(user)) } data-signals:usuarioSaving="false" data-signals:usuarioSaved="false" data-effect="if ($usuarioSaving) { const button = document.getElementById('usuario-submit'); if (button) { button.disabled = true; button.setAttribute('aria-busy','true'); button.textContent = 'Guardando...'; } } else { const button = document.getElementById('usuario-submit'); if (button) { button.disabled = false; button.removeAttribute('aria-busy'); button.textContent = 'Guardar usuario'; } } if ($usuarioSaved) { window.templ?.dialog?.close('usuario-dialog'); $usuarioSaved = false; }" data-on:submit__prevent={ usuarioFormSubmitScript(user) }>
			<input type="hidden" name="usuarioID" data-bind:usuarioID />
			<input type="hidden" name="usuarioMode" data-bind:usuarioMode />
			<div class="grid gap-4 sm:grid-cols-2">
				@usuarioTextField("usuario-nombres", "Nombres", "nombres", "Ingrese los nombres", true)
				@usuarioTextField("usuario-apellido1", "Primer apellido", "apellido1", "Ingrese el primer apellido", true)
				@usuarioTextField("usuario-username", "Usuario", "username", "Nombre de usuario", true)
				@usuarioTextField("usuario-password", "Contraseña", "password", "Contraseña inicial", user == nil)
			</div>

			<div class="space-y-3 rounded-lg border border-border/60 bg-muted/20 p-3">
				<div class="flex items-center justify-between gap-3">
					<div>
						<p class="text-sm font-medium">Roles y unidades</p>
						<p class="text-xs text-muted-foreground">Cada unidad solo puede aparecer una vez.</p>
					</div>
					<span class="text-xs text-destructive">Obligatorio</span>
				</div>
				<div class="grid gap-3 sm:grid-cols-[1fr_1fr_auto] sm:items-end">
					<div class="space-y-2">
						<label for="usuario-rol" class="text-sm font-medium">Rol</label>
						<select id="usuario-rol" data-usuario-role class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm" data-bind:rol-form>
							<option value="">Seleccione un rol</option>
							for _, role := range roles {
								<option value={ role.ID }>{ role.Nombre }</option>
							}
						</select>
					</div>
					<div class="space-y-2">
						<label for="usuario-unidad" class="text-sm font-medium">Unidad</label>
						<select id="usuario-unidad" data-usuario-unit class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm" data-bind:unidad-form>
							<option value="">Seleccione una unidad</option>
							for _, unidad := range unidades {
								<option value={ unidad.ID }>{ unidad.Nombre }</option>
							}
						</select>
					</div>
					@button.Button(button.Props{Type: button.TypeButton, Class: "h-9", Attributes: templ.Attributes{"data-on:click": usuarioAddRoleUnitScript()}}) { Agregar }
				</div>
				<div data-usuario-roles-error></div>
				<div data-usuario-roles-list class="space-y-2">
					if user != nil {
						for _, pair := range user.Roles {
							if pair != nil {
								<div data-usuario-pair={ pair.UnidadID } class="flex items-center justify-between gap-3 rounded-md border border-border/60 bg-background px-3 py-2 text-sm">
									<span>{ pair.RolName + " · " + pair.UnidadName }</span>
									<button type="button" class="text-xs text-muted-foreground hover:text-destructive" data-on:click={ usuarioRemoveRoleUnitScript() }>Quitar</button>
								</div>
							}
						}
					}
				</div>
				<input type="hidden" name="rolesJson" data-bind:roles-json required />
			</div>

			<div id="usuario-form-error"></div>

			<details class="group rounded-lg border border-border/60 bg-muted/10">
				<summary class="cursor-pointer list-none px-3 py-2.5 text-sm font-medium [&::-webkit-details-marker]:hidden"><span class="mr-2 inline-block transition-transform group-open:rotate-90">›</span>Datos complementarios</summary>
				<div class="grid gap-4 border-t border-border/60 p-3 sm:grid-cols-2">
					@usuarioTextField("usuario-apellido2", "Segundo apellido", "apellido2", "Ingrese el segundo apellido", false)
					@usuarioTextField("usuario-documento", "Documento", "documento", "Número de documento", false)
					@usuarioTextField("usuario-celular", "Celular", "celular", "Número de celular", false)
					@usuarioTextField("usuario-correo", "Correo", "correo", "correo@ejemplo.com", false)
					<div class="space-y-2"><label for="usuario-sexo" class="text-sm font-medium">Sexo</label><select id="usuario-sexo" class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm" data-bind:sexo><option value="">Sin especificar</option><option value="M">Masculino</option><option value="F">Femenino</option></select></div>
					<div class="space-y-2"><label for="usuario-foto" class="text-sm font-medium">Foto</label><input id="usuario-foto" type="file" accept="image/jpeg,image/png" class="flex h-9 w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm file:mr-3 file:border-0 file:bg-transparent file:text-sm file:font-medium" data-on:change="const file = evt.target.files?.[0]; if (!file) { $foto64 = ''; return; } if (!['image/jpeg','image/png'].includes(file.type)) { evt.target.value = ''; $foto64 = ''; return; } const reader = new FileReader(); reader.onload = () => { $foto64 = reader.result; }; reader.readAsDataURL(file)" /></div>
					<div class="space-y-2 sm:col-span-2"><label for="usuario-direccion" class="text-sm font-medium">Dirección</label><textarea id="usuario-direccion" class="min-h-20 w-full rounded-md border border-input bg-background px-3 py-2 text-sm" placeholder="Dirección del usuario" data-bind:direccion></textarea></div>
				</div>
			</details>

			@dialog.Footer() {
				@button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeButton, Attributes: dialog.Close(ctx)}) { Cancelar }
				@button.Button(button.Props{Type: button.TypeSubmit, ID: "usuario-submit"}) { Guardar usuario }
			}
		</form>
	</div>
}

templ usuarioTextField(id, label, signal, placeholder string, required bool) {
	@field.Field() {
		@field.Label(field.LabelProps{For: id}) { { label } }
		@input.Input(input.Props{ID: id, Type: usuarioInputType(signal), Placeholder: placeholder, Required: required, Class: "h-9 rounded-md", Attributes: usuarioBind(signal)})
	}
}

templ UsuarioFormError(message string) {
	if message != "" {
		<div id="usuario-form-error" role="alert" class="rounded-md border border-destructive/30 bg-destructive/10 px-3 py-2 text-sm text-destructive">{ message }</div>
	} else {
		<div id="usuario-form-error"></div>
	}
}

