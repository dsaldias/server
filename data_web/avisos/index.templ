package avisos

import "github.com/dsaldias/server/data_web/components/button"
import "github.com/dsaldias/server/data_web/components/dialog"
import "github.com/dsaldias/server/data_web/components/icon"
import "github.com/dsaldias/server/data_web/xutility"
import "github.com/dsaldias/server/graph_auth/model"

templ RenderAvisos(data AvisosPageData) {
	@dialog.Dialog(dialog.Props{ID: "aviso-dialog"}) {
		<div id="avisos-page" class="mx-auto max-w-7xl space-y-6" data-signals:avisoTimezone="''">
			@xutility.PageHeader("Avisos", "Administra los avisos activos del sistema.") {
				@button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeButton, Attributes: templ.Attributes{"data-on:click": "@get('/adminx/avisos')"}}) { @icon.RefreshCw(icon.Props{Class: "size-4"}) Refrescar }
				@button.Button(button.Props{Type: button.TypeButton, Attributes: templ.Attributes{"data-slot": "dialog-trigger", "data-base-ui-click-trigger": true, "data-templ-controls": "aviso-dialog", "aria-haspopup": "dialog", "aria-expanded": "false", "data-on:click": avisoCreateResetScript()}}) { @icon.Plus(icon.Props{Class: "size-4"}) Nuevo aviso }
			}
			@AvisosTableRegion(data)
			@AvisoViewDialogs(data)
		</div>
		@AvisoForm()
	}
}

templ AvisoForm() {
	@dialog.Content(dialog.ContentProps{Class: "!bg-card !text-card-foreground shadow-2xl sm:max-w-2xl"}) {
		@dialog.Header() { @dialog.Title() { <span data-aviso-title>Nuevo aviso</span> } @dialog.Description() { Define el mensaje y el periodo en el que estará activo. } }
		<form id="aviso-form" class="space-y-5" data-signals:avisoMode="'create'" data-signals:avisoID="''" data-signals:avisoTimezone="''" data-signals:avisoSaving="false" data-signals:avisoSaved="false" data-on:submit__prevent="$avisoTimezone=Intl.DateTimeFormat().resolvedOptions().timeZone;$avisoSaving=true; @post('/adminx/avisos')" data-effect="const button=document.getElementById('aviso-submit');if(button){button.disabled=$avisoSaving;button.setAttribute('aria-busy',$avisoSaving?'true':'false');button.textContent=$avisoSaving?'Guardando...':'Guardar aviso';}if($avisoSaved){window.templ?.dialog?.close('aviso-dialog');$avisoSaved=false;}">
			<label for="aviso-mensaje" class="space-y-2 text-sm font-medium">Mensaje<textarea id="aviso-mensaje" name="mensaje" required maxlength="1000" class="min-h-28 w-full rounded-md border border-input bg-background px-3 py-2 text-sm" placeholder="Escribe el aviso..." data-bind:mensaje></textarea></label>
			<div class="grid gap-4 sm:grid-cols-2"><label for="aviso-desde" class="space-y-2 text-sm font-medium">Desde<input id="aviso-desde" name="desde" type="datetime-local" required class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm" data-bind:desde /></label><label for="aviso-hasta" class="space-y-2 text-sm font-medium">Hasta<input id="aviso-hasta" name="hasta" type="datetime-local" required class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm" data-bind:hasta /></label></div>
			<div id="aviso-form-error"></div>
			@dialog.Footer() { @button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeButton, Attributes: dialog.Close(ctx)}) { Cancelar } @button.Button(button.Props{Type: button.TypeSubmit, ID: "aviso-submit"}) { Guardar aviso } }
		</form>
	}
}

templ AvisosTableRegion(data AvisosPageData) {
	@xutility.TableRegion("avisos-table-region") {
		if data.Error != "" {
			@xutility.ErrorState(data.Error)
		} else if len(data.Listado) > 0 {
			@xutility.TableCard() {
				<div class="overflow-x-auto"><table class="w-full text-sm"><thead class="border-b border-border/60 bg-muted/40 text-left text-xs uppercase tracking-wide text-muted-foreground"><tr><th class="px-3 py-2 font-medium">Mensaje</th><th class="px-3 py-2 font-medium">Desde</th><th class="px-3 py-2 font-medium">Hasta</th><th class="px-3 py-2 font-medium">Registro</th><th class="px-3 py-2 text-right font-medium">Acciones</th></tr></thead><tbody class="divide-y divide-border/60">
					for _, aviso := range data.Listado {
						if aviso != nil {
							<tr class="transition-colors hover:bg-muted/40"><td class="max-w-xl whitespace-pre-wrap px-3 py-2 font-medium">{ aviso.Mensaje }</td><td class="whitespace-nowrap px-3 py-2 text-muted-foreground">{ avisoDate(aviso.Desde) }</td><td class="whitespace-nowrap px-3 py-2 text-muted-foreground">{ avisoDate(aviso.Hasta) }</td><td class="whitespace-nowrap px-3 py-2 text-muted-foreground">{ avisoDate(aviso.FechaRegistro) }</td><td class="px-3 py-2"><div class="flex justify-end gap-1">@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIconSm, Type: button.TypeButton, Attributes: avisoViewAttributes(aviso.ID)}) { @icon.Eye(icon.Props{Class: "size-4"})<span class="sr-only">Visualizar aviso</span> } @button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIconSm, Type: button.TypeButton, Attributes: avisoEditAttributes(aviso)}) { @icon.Pencil(icon.Props{Class: "size-4"})<span class="sr-only">Editar aviso</span> }</div></td></tr>
						}
					}
				</tbody></table></div>
			}
		} else {
			@xutility.EmptyState("No hay avisos activos.")
		}
	}
}

templ AvisoViewDialogs(data AvisosPageData) {
	for _, aviso := range data.Listado {
		if aviso != nil {
			@dialog.Dialog(dialog.Props{ID: "aviso-view-" + aviso.ID}) { @AvisoView(aviso) }
		}
	}
}

templ AvisoView(aviso *model.Notificacion) {
	@dialog.Content(dialog.ContentProps{Class: "!bg-card !text-card-foreground shadow-2xl sm:max-w-xl"}) {
		@dialog.Header() { @dialog.Title() { Aviso } @dialog.Description() { Detalle del aviso seleccionado. } }
		<div class="space-y-4"><div class="rounded-lg border border-border/60 bg-muted/20 p-4"><p class="whitespace-pre-wrap text-sm">{ aviso.Mensaje }</p></div><dl class="grid gap-3 sm:grid-cols-2"><div><dt class="text-xs text-muted-foreground">Desde</dt><dd class="text-sm font-medium">{ avisoDate(aviso.Desde) }</dd></div><div><dt class="text-xs text-muted-foreground">Hasta</dt><dd class="text-sm font-medium">{ avisoDate(aviso.Hasta) }</dd></div><div><dt class="text-xs text-muted-foreground">Registrado</dt><dd class="text-sm font-medium">{ avisoDate(aviso.FechaRegistro) }</dd></div><div><dt class="text-xs text-muted-foreground">Creado por</dt><dd class="text-sm font-medium">{ aviso.CreadoPorID }</dd></div></dl></div>
	}
}
