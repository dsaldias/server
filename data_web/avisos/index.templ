package avisos

import "github.com/dsaldias/server/data_web/components/button"
import "github.com/dsaldias/server/data_web/components/dialog"
import "github.com/dsaldias/server/data_web/components/icon"
import "github.com/dsaldias/server/data_web/xutility/marco"

templ RenderAvisos(data AvisosPageData) {
	@dialog.Dialog(dialog.Props{ID: "aviso-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "!bg-card !text-card-foreground shadow-2xl sm:max-w-2xl", Attributes: templ.Attributes{"data-on:dialog-close": avisoModalLoadingScript()}}) {
			@dialog.Header() { @dialog.Title() { <span data-aviso-title>Nuevo aviso</span> } @dialog.Description() { <span data-templ-dialog-description>Define el mensaje y el periodo en el que estará activo.</span> } }
			@AvisoModalLoading()
		}
	}
	@marco.AdminTable(marco.AdminTableProps{Title: "Avisos", Description: "Administra los avisos activos del sistema.", RegionID: "avisos-table-region", Attributes: templ.Attributes{"id": "avisos-page", "data-signals:avisosLoading": "false"}, HeaderActions: AvisoHeaderActions(), Filters: nil}) { @AvisosTableContent(data) }
}

templ AvisoHeaderActions() {
	@button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeButton, Attributes: templ.Attributes{"data-avisos-refresh": true, "data-on:click": avisosRefreshScript(), "data-effect": avisosLoadingEffectScript()}}) { <span data-avisos-refresh-icon>@icon.RefreshCw(icon.Props{Class: "size-4"})</span><span data-avisos-refresh-label>Refrescar</span> }
	@button.Button(button.Props{Type: button.TypeButton, Attributes: templ.Attributes{"data-slot": "dialog-trigger", "data-base-ui-click-trigger": true, "data-templ-controls": "aviso-dialog", "aria-haspopup": "dialog", "aria-expanded": "false", "data-aviso-modal-action": true, "data-on:click": avisoModalRequestScript(ADMIN_AVISOS_FORMHTML)}}) { @icon.Plus(icon.Props{Class: "size-4"}) Nuevo aviso }
}
