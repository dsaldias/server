package avisos

import "github.com/dsaldias/server/data_web/components/button"
import "github.com/dsaldias/server/data_web/components/dialog"
import "github.com/dsaldias/server/graph_auth/model"

templ AvisoModalLoading() {
	<div id="aviso-dialog-content" class="flex min-h-40 items-center justify-center gap-2 text-sm text-muted-foreground"><span class="size-4 animate-spin rounded-full border-2 border-current border-t-transparent"></span>Cargando, espere...</div>
}

templ AvisoForm(aviso *model.Notificacion) {
	<div id="aviso-dialog-content"><form id="aviso-form" class="space-y-5" data-signals:avisoMode={ avisoSignalString(avisoFormMode(aviso)) } data-signals:avisoID={ avisoSignalString(avisoFormID(aviso)) } data-signals:avisoMensaje={ avisoSignalString(avisoFormValue(aviso, "mensaje")) } data-signals:avisoDesde={ avisoSignalString(avisoFormValue(aviso, "desde")) } data-signals:avisoHasta={ avisoSignalString(avisoFormValue(aviso, "hasta")) } data-signals:avisoTimezone="''" data-signals:avisoSaving="false" data-on:submit__prevent={ avisoFormSubmitScript(aviso != nil) } data-effect="const button=document.getElementById('aviso-submit');if(button){button.disabled=$avisoSaving;button.setAttribute('aria-busy',$avisoSaving?'true':'false');button.textContent=$avisoSaving?'Guardando...':'Guardar aviso';}">
		<label for="aviso-mensaje" class="space-y-2 text-sm font-medium">Mensaje<textarea id="aviso-mensaje" name="mensaje" required maxlength="1000" class="min-h-28 w-full rounded-md border border-input bg-background px-3 py-2 text-sm" placeholder="Escribe el aviso..." data-bind:avisoMensaje></textarea></label>
		<div class="grid gap-4 sm:grid-cols-2"><label for="aviso-desde" class="space-y-2 text-sm font-medium">Desde<input id="aviso-desde" name="desde" type="datetime-local" required class="h-9 w-full rounded-md border border-input bg-background px-3 py-2 text-sm" data-bind:avisoDesde /></label><label for="aviso-hasta" class="space-y-2 text-sm font-medium">Hasta<input id="aviso-hasta" name="hasta" type="datetime-local" required class="h-9 w-full rounded-md border border-input bg-background px-3 py-2 text-sm" data-bind:avisoHasta /></label></div>
		<div id="aviso-form-error"></div>
		@dialog.Footer() { @button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeButton, Attributes: dialog.Close(ctx)}) { Cancelar } @button.Button(button.Props{Type: button.TypeSubmit, ID: "aviso-submit"}) { Guardar aviso } }
	</form></div>
}
