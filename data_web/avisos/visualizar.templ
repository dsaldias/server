package avisos

import "github.com/dsaldias/server/data_web/xutility"
import "github.com/dsaldias/server/graph_auth/model"

templ AvisoView(aviso *model.Notificacion) {
	<div id="aviso-dialog-content"><div class="space-y-4">
		@xutility.ReadSection("Mensaje") { <p class="whitespace-pre-wrap text-sm">{ aviso.Mensaje }</p> }
		<div class="grid gap-3 sm:grid-cols-2"><div><p class="text-xs text-muted-foreground">Desde</p><p class="text-sm font-medium">{ avisoDate(aviso.Desde) }</p></div><div><p class="text-xs text-muted-foreground">Hasta</p><p class="text-sm font-medium">{ avisoDate(aviso.Hasta) }</p></div><div><p class="text-xs text-muted-foreground">Registrado</p><p class="text-sm font-medium">{ avisoDate(aviso.FechaRegistro) }</p></div><div><p class="text-xs text-muted-foreground">Creado por</p><p class="text-sm font-medium">{ aviso.CreadoPorID }</p></div></div>
	</div></div>
}

templ AvisoModalError(message string) { <div id="aviso-dialog-content"><div class="rounded-md border border-destructive/30 bg-destructive/10 p-4 text-sm text-destructive" role="alert">{ message }</div></div> }
