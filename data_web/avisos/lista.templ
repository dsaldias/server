package avisos

import "github.com/dsaldias/server/data_web/components/button"
import "github.com/dsaldias/server/data_web/components/icon"
import "github.com/dsaldias/server/data_web/xutility/marco"

templ AvisosTableRegion(data AvisosPageData) { @marco.TableRegion("avisos-table-region") { @AvisosTableContent(data) } }

templ AvisosTableContent(data AvisosPageData) {
	if data.Error != "" {
		@marco.ErrorState(data.Error)
	} else if len(data.Listado) == 0 {
		@marco.EmptyState("No hay avisos activos.")
	} else {
		@marco.TableCard() { <div class="overflow-x-auto"><table class="w-full text-sm"><thead class="border-b border-border/60 bg-muted/40 text-left text-xs uppercase tracking-wide text-muted-foreground"><tr><th class="px-3 py-2 font-medium">Mensaje</th><th class="px-3 py-2 font-medium">Desde</th><th class="px-3 py-2 font-medium">Hasta</th><th class="px-3 py-2 font-medium">Registro</th><th class="px-3 py-2 text-right font-medium">Acciones</th></tr></thead><tbody class="divide-y divide-border/60">
			for _, aviso := range data.Listado {
				if aviso != nil {
					<tr class="transition-colors hover:bg-muted/40"><td class="max-w-xl whitespace-pre-wrap px-3 py-2 font-medium">{ aviso.Mensaje }</td><td class="whitespace-nowrap px-3 py-2 text-muted-foreground">{ avisoDate(aviso.Desde) }</td><td class="whitespace-nowrap px-3 py-2 text-muted-foreground">{ avisoDate(aviso.Hasta) }</td><td class="whitespace-nowrap px-3 py-2 text-muted-foreground">{ avisoDate(aviso.FechaRegistro) }</td><td class="px-3 py-2"><div class="flex justify-end gap-1">@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIconSm, Type: button.TypeButton, Attributes: templ.Attributes{"tabindex": "0", "data-slot": "dialog-trigger", "data-base-ui-click-trigger": true, "data-templ-controls": "aviso-dialog", "aria-haspopup": "dialog", "aria-expanded": "false", "data-aviso-modal-action": true, "data-on:click": avisoModalRequestWithIDScript(ADMIN_AVISOS_VERHTML, aviso.ID)}}) { @icon.Eye(icon.Props{Class: "size-4"})<span class="sr-only">Visualizar aviso</span> } @button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIconSm, Type: button.TypeButton, Attributes: templ.Attributes{"tabindex": "0", "data-slot": "dialog-trigger", "data-base-ui-click-trigger": true, "data-templ-controls": "aviso-dialog", "aria-haspopup": "dialog", "aria-expanded": "false", "data-aviso-modal-action": true, "data-on:click": avisoModalRequestWithIDScript(ADMIN_AVISOS_EDITHTML, aviso.ID)}}) { @icon.Pencil(icon.Props{Class: "size-4"})<span class="sr-only">Editar aviso</span> }</div></td></tr>
				}
			}
		</tbody></table></div> }
	}
}
