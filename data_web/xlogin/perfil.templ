package xlogin

import "github.com/dsaldias/server/data_web/components/avatar"
import "github.com/dsaldias/server/data_web/components/button"
import "github.com/dsaldias/server/data_web/components/dialog"
import "github.com/dsaldias/server/data_web/components/field"
import "github.com/dsaldias/server/data_web/components/input"
import "github.com/dsaldias/server/graph_auth/model"

templ PerfilDialog(user *model.Usuario) {
	@dialog.Dialog(dialog.Props{ID: "perfil-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "!bg-card !text-card-foreground shadow-2xl sm:max-w-2xl"}) {
			@dialog.Header() {
				@dialog.Title() { Editar mi perfil }
				@dialog.Description() { Actualiza tus datos personales y, si lo necesitas, cambia tu contraseña o foto. }
			}

			<form id="perfil-form" class="max-h-[calc(100vh-10rem)] space-y-5 overflow-y-auto pr-1" data-signals:nombres={ perfilSignalString(perfilUserString(user, "nombres")) } data-signals:apellido1={ perfilSignalString(perfilUserString(user, "apellido1")) } data-signals:apellido2={ perfilSignalString(perfilUserString(user, "apellido2")) } data-signals:documento={ perfilSignalString(perfilUserString(user, "documento")) } data-signals:celular={ perfilSignalString(perfilUserString(user, "celular")) } data-signals:correo={ perfilSignalString(perfilUserString(user, "correo")) } data-signals:sexo={ perfilSignalString(perfilUserString(user, "sexo")) } data-signals:direccion={ perfilSignalString(perfilUserString(user, "direccion")) } data-signals:username={ perfilSignalString(perfilUserString(user, "username")) } data-signals:password="''" data-signals:foto64="''" data-signals:latitud={ perfilSignalString(perfilUserString(user, "latitud")) } data-signals:longitud={ perfilSignalString(perfilUserString(user, "longitud")) } data-signals:perfilSaving="false" data-signals:perfilSaved="false" data-effect="const button=document.getElementById('perfil-submit');if(button){button.disabled=$perfilSaving;button.setAttribute('aria-busy',$perfilSaving?'true':'false');button.textContent=$perfilSaving?'Guardando...':'Guardar cambios';}if($perfilSaved){window.templ?.dialog?.close('perfil-dialog');$perfilSaved=false;setTimeout(()=>window.location.reload(),150);}" data-on:submit__prevent="$perfilSaving=true; @post('/adminx/perfil')">
				<div class="flex items-center gap-4 rounded-lg border border-border/60 bg-muted/20 p-3">
					@avatar.Avatar(avatar.Props{ID: "perfil-avatar-preview", Size: avatar.SizeLg}) {
						@avatar.Image(avatar.ImageProps{ID: "perfil-photo-preview", Src: perfilPhotoURL(user), Alt: "Foto de perfil"})
						@avatar.Fallback() { { inicioUserInitials(&model.ResponseMe{Usuario: user}) } }
					}
					<div class="min-w-0 flex-1"><p class="text-sm font-medium">Foto de perfil</p><p class="text-xs text-muted-foreground">JPG o PNG. La imagen se enviará como Base64.</p></div>
					<label for="perfil-foto" class="cursor-pointer rounded-lg border border-border bg-background px-3 py-2 text-sm font-medium hover:bg-muted">Seleccionar<input id="perfil-foto" type="file" accept="image/jpeg,image/png" class="sr-only" data-on:change="const file=evt.target.files?.[0];if(!file){$foto64='';return;}if(!['image/jpeg','image/png'].includes(file.type)){evt.target.value='';$foto64='';return;}const reader=new FileReader();reader.onload=()=>{$foto64=reader.result;const image=document.getElementById('perfil-photo-preview');if(image){image.src=reader.result;image.hidden=false;}};reader.readAsDataURL(file)" /></label>
				</div>

				<div class="grid gap-4 sm:grid-cols-2">
					@perfilTextField("perfil-nombres", "Nombres", "nombres", "Tus nombres", true)
					@perfilTextField("perfil-apellido1", "Primer apellido", "apellido1", "Tu primer apellido", true)
				</div>

				<div id="perfil-form-error"></div>

				<details class="group rounded-lg border border-border/60 bg-muted/10">
					<summary class="cursor-pointer list-none px-3 py-2.5 text-sm font-medium [&::-webkit-details-marker]:hidden"><span class="mr-2 inline-block transition-transform group-open:rotate-90">›</span>Datos complementarios</summary>
					<div class="grid gap-4 border-t border-border/60 p-3 sm:grid-cols-2">
						@perfilTextField("perfil-apellido2", "Segundo apellido", "apellido2", "Tu segundo apellido", false)
						@perfilTextField("perfil-documento", "Documento", "documento", "Número de documento", false)
						@perfilTextField("perfil-celular", "Celular", "celular", "Número de celular", false)
						@perfilTextField("perfil-correo", "Correo", "correo", "correo@ejemplo.com", false)
						<div class="space-y-2"><label for="perfil-sexo" class="text-sm font-medium">Sexo</label><select id="perfil-sexo" class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm" data-bind:sexo><option value="">Sin especificar</option><option value="M">Masculino</option><option value="F">Femenino</option></select></div>
						<div class="space-y-2"><label for="perfil-username" class="text-sm font-medium">Usuario</label>@input.Input(input.Props{ID: "perfil-username", Placeholder: "Nombre de usuario", Attributes: templ.Attributes{"data-bind:username": true}})</div>
						<div class="space-y-2 sm:col-span-2"><label for="perfil-direccion" class="text-sm font-medium">Dirección</label><textarea id="perfil-direccion" class="min-h-20 w-full rounded-md border border-input bg-background px-3 py-2 text-sm" placeholder="Dirección" data-bind:direccion></textarea></div>
						<div class="space-y-2"><label for="perfil-latitud" class="text-sm font-medium">Latitud</label>@input.Input(input.Props{ID: "perfil-latitud", Type: "number", Placeholder: "Opcional", Attributes: templ.Attributes{"step": "any", "data-bind:latitud": true}})</div>
						<div class="space-y-2"><label for="perfil-longitud" class="text-sm font-medium">Longitud</label>@input.Input(input.Props{ID: "perfil-longitud", Type: "number", Placeholder: "Opcional", Attributes: templ.Attributes{"step": "any", "data-bind:longitud": true}})</div>
						<div class="space-y-2 sm:col-span-2"><label for="perfil-password" class="text-sm font-medium">Nueva contraseña</label>@input.Input(input.Props{ID: "perfil-password", Type: "password", Placeholder: "Déjala vacía para conservar la actual", Attributes: templ.Attributes{"autocomplete": "new-password", "data-bind:password": true}})<p class="text-xs text-muted-foreground">Solo se cambia si escribes una nueva.</p></div>
					</div>
				</details>

				@dialog.Footer() {
					@button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeButton, Attributes: dialog.Close(ctx)}) { Cancelar }
					@button.Button(button.Props{Type: button.TypeSubmit, ID: "perfil-submit"}) { Guardar cambios }
				}
			</form>
		}
	}
}

templ perfilTextField(id, label, signal, placeholder string, required bool) {
	@field.Field() {
		@field.Label(field.LabelProps{For: id}) { { label } }
		@input.Input(input.Props{ID: id, Placeholder: placeholder, Required: required, Attributes: perfilBind(signal)})
	}
}

templ PerfilFormError(message string) {
	if message != "" {
		<div id="perfil-form-error" role="alert" class="rounded-md border border-destructive/30 bg-destructive/10 px-3 py-2 text-sm text-destructive">{ message }</div>
	} else {
		<div id="perfil-form-error"></div>
	}
}
