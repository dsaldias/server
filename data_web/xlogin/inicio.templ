package xlogin

import "github.com/dsaldias/server/data_web/components/avatar"
import "github.com/dsaldias/server/data_web/components/button"
import "github.com/dsaldias/server/data_web/components/card"
import "github.com/dsaldias/server/data_web/components/combobox"
import "github.com/dsaldias/server/data_web/components/dialog"
import "github.com/dsaldias/server/data_web/components/dropdownmenu"
import "github.com/dsaldias/server/data_web/components/icon"
import "github.com/dsaldias/server/data_web/components/separator"
import "github.com/dsaldias/server/data_web/xutility"

templ InicioRender(data InicioData) {
	<div id="admin-shell" data-sidebar-collapsed="false" class="relative flex min-h-screen bg-background text-foreground">
		@InicioSidebar(data)
		@xutility.ConnectedUsersDialog()
		if data.Me != nil && data.Me.Usuario != nil {
			@PerfilDialog(data.Me.Usuario)
		}
		<div class="flex min-w-0 flex-1 flex-col">
		<header class="sticky top-0 z-40 flex h-14 items-center justify-between border-b bg-header px-3 shadow-sm sm:px-5">
			<div class="flex min-w-0 items-center gap-3">
				@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIcon, Attributes: templ.Attributes{"data-on:click": "const shell = document.getElementById('admin-shell'); const collapsed = shell.dataset.sidebarCollapsed === 'true'; shell.dataset.sidebarCollapsed = String(!collapsed); document.getElementById('admin-sidebar')?.classList.toggle('hidden', !collapsed); document.getElementById('admin-sidebar')?.classList.toggle('flex', collapsed)"}}) {
					@icon.PanelLeft(icon.Props{Class: "size-5"})
					<span class="sr-only">Mostrar u ocultar menú lateral</span>
				}
				<div class="hidden min-w-0 sm:block"><p class="truncate text-sm font-semibold">Sistema administrativo</p><p class="truncate text-xs text-muted-foreground">Panel de control</p></div>
			</div>
			<div class="flex min-w-0 items-center gap-1 sm:gap-2">
				@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIcon, Attributes: templ.Attributes{"data-on:click": "const dark = document.documentElement.classList.toggle('dark'); localStorage.setItem('theme', dark ? 'dark' : 'light')"}}) {
					@icon.Sun(icon.Props{Class: "size-4 dark:hidden"})
					@icon.Moon(icon.Props{Class: "hidden size-4 dark:block"})
					<span class="sr-only">Cambiar tema</span>
				}
				<div class="hidden w-64 sm:block" data-signals:context={ inicioContextSignal(data.UnidadID, data.RolID) } data-context-selector>
					<div data-on:combobox-change="const selector = evt.currentTarget; selector.setAttribute('aria-busy','true'); selector.querySelectorAll('input,button').forEach(element => element.disabled = true); $context = evt.detail.values[0]; @post('/adminx/context')">
					@combobox.Combobox(combobox.Props{ID: "unit-role-selector", DefaultValue: data.UnidadID + "|" + data.RolID, Items: inicioRoleItems(data.Me)}) {
						@combobox.Input(combobox.InputProps{Placeholder: "Seleccionar unidad / rol"})
						@combobox.Content() {
							@combobox.Empty() { No hay coincidencias. }
							@combobox.List() {
								if data.Me != nil {
									for _, role := range data.Me.Roles {
										if role.Unidad != nil && role.Rol != nil {
											@combobox.Item(combobox.ItemProps{Value: role.Unidad.ID + "|" + role.Rol.ID, Label: role.Unidad.Nombre + " / " + role.Rol.Nombre}) {
												<div class="flex flex-col text-left"><span class="font-medium">{ role.Unidad.Nombre }</span><span class="text-xs text-muted-foreground">{ role.Rol.Nombre }</span></div>
											}
										}
									}
								}
							}
						}
					}
					</div>
					<div id="context-result"></div>
				</div>
				<div class="hidden max-w-48 text-right sm:block"><p class="truncate text-sm font-medium">{ inicioUserName(data.Me) }</p><p id="active-role" class="truncate text-xs text-muted-foreground">{ inicioSelectedRole(data.Me, data.UnidadID, data.RolID) }</p></div>
				@avatar.Avatar(avatar.Props{Size: avatar.SizeSm}) {
					if foto := perfilPhotoURL(inicioUser(data.Me)); foto != "" {
						@avatar.Image(avatar.ImageProps{Src: foto, Alt: "Foto de perfil"})
					}
					@avatar.Fallback() { { inicioUserInitials(data.Me) } }
				}
			</div>
		</header>

			<main id="admin-content" class="min-w-0 flex-1 bg-muted/30 p-4 sm:p-6 lg:p-8">
				if data.Content != nil {
					@data.Content
				} else {
					<div class="mx-auto max-w-7xl"><div class="mb-6 flex flex-wrap items-end justify-between gap-3"><div><p class="text-sm text-muted-foreground">Bienvenido de nuevo</p><h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">Panel administrativo</h1></div><div class="sm:hidden"><p class="text-right text-sm font-medium">{ inicioUserName(data.Me) }</p><p class="text-right text-xs text-muted-foreground">{ inicioSelectedRole(data.Me, data.UnidadID, data.RolID) }</p></div></div><div class="grid gap-4 md:grid-cols-3">
						@card.Card() { @card.Header() { @card.Title() { Estado del sistema } } @card.Content() { <div class="h-16 rounded-lg bg-muted"></div> } }
						@card.Card() { @card.Header() { @card.Title() { Actividad reciente } } @card.Content() { <div class="h-16 rounded-lg bg-muted"></div> } }
						@card.Card() { @card.Header() { @card.Title() { Accesos rápidos } } @card.Content() { <div class="h-16 rounded-lg bg-muted"></div> } }
					</div></div>
				}
			</main>
		</div>
	</div>
	if !data.Authenticated {
		@dialog.Dialog(dialog.Props{ID: "relogin-dialog", DefaultOpen: true}) {
			@dialog.Content(dialog.ContentProps{Class: "!bg-card !text-card-foreground shadow-2xl sm:max-w-md", HideCloseButton: true}) {
				@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIcon, Type: button.TypeButton, Class: "absolute right-4 top-4", Attributes: templ.Attributes{"data-on:click": "window.location.href = '/adminx'"}}) { @icon.X(icon.Props{Class: "size-4"}) }
				@dialog.Header() { @dialog.Title() { Tu sesión expiró } @dialog.Description() { Vuelve a ingresar tus credenciales para continuar trabajando. } }
				@reloginForm()
			}
		}
	}
}

templ InicioSidebar(data InicioData) {
	<aside id="admin-sidebar" class="sticky top-0 hidden h-screen w-72 shrink-0 flex-col border-r bg-sidebar text-sidebar-foreground shadow-sm md:flex">
		<div class="flex h-16 items-center gap-3 border-b border-sidebar-border px-5"><div class="flex size-9 items-center justify-center rounded-xl bg-sidebar-foreground/10"><button type="button" data-slot="dialog-trigger" data-base-ui-click-trigger data-templ-controls="connected-users-dialog" aria-haspopup="dialog" aria-expanded="false" data-ws-connected-summary data-on:click="@get('/adminx/conectados')" class="flex size-9 items-center justify-center rounded-xl"><span data-ws-status class="size-2.5 rounded-full bg-orange-500 shadow-[0_0_18px_#f97316]"></span><span class="sr-only">Estado de conexión y usuarios conectados</span></button></div><div class="min-w-0"><p class="truncate text-sm font-semibold">Administración</p><p class="truncate text-xs text-sidebar-foreground/60"><span data-ws-unique>0</span> conectados</p></div></div>
		<div class="flex-1 overflow-y-auto p-4"><p class="px-2 text-xs font-medium uppercase tracking-wider text-sidebar-foreground/50">Menú lateral</p><nav class="mt-3 space-y-1" aria-label="Menú principal">
			if data.Me != nil {
				for _, parent := range inicioRootMenus(data.Me.Menus) {
					{{ children := inicioChildMenus(data.Me.Menus, parent.ID) }}
					if len(children) > 0 {
						<div class="space-y-1">
							@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantGhost, Class: "h-10 w-full justify-start gap-2 px-2 text-sidebar-foreground hover:bg-sidebar-foreground/10 hover:text-sidebar-foreground", Attributes: templ.Attributes{"data-on:click": "document.getElementById('admin-menu-" + parent.ID + "')?.classList.toggle('hidden')"}}) { @icon.Folder(icon.Props{Class: "size-4"})<span class="truncate">{ parent.Label }</span><span class="ml-auto text-xs">⌄</span> }
							<div id={ "admin-menu-" + parent.ID } class={ inicioMenuExpanded(children, data.ActivePath) }>
								for _, child := range children {
									@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantGhost, Class: inicioMenuClass(child.Path, data.ActivePath, "h-9 w-full justify-start px-2 text-left text-sm text-sidebar-foreground/75 hover:bg-sidebar-foreground/10 hover:text-sidebar-foreground"), Attributes: templ.Attributes{"data-menu-path": child.Path, "data-on:click": inicioMenuClick(child)}}) { <span class="truncate">{ child.Label }</span> }
								}
							</div>
						</div>
					} else {
						@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantGhost, Class: inicioMenuClass(parent.Path, data.ActivePath, "h-10 w-full justify-start gap-2 px-2 text-sidebar-foreground hover:bg-sidebar-foreground/10 hover:text-sidebar-foreground"), Attributes: templ.Attributes{"data-menu-path": parent.Path, "data-on:click": inicioMenuClick(parent)}}) { @icon.FileText(icon.Props{Class: "size-4"})<span class="truncate">{ parent.Label }</span> }
					}
				}
			}
		</nav></div>
		@separator.Separator(separator.Props{Class: "bg-sidebar-border"})
		<div class="p-3">
			@dropdownmenu.DropdownMenu(dropdownmenu.Props{ID: "profile-menu"}) {
				@button.Button(button.Props{Variant: button.VariantGhost, Class: "h-auto w-full justify-start gap-3 px-2 py-2 text-sidebar-foreground hover:bg-sidebar-foreground/10 hover:text-sidebar-foreground", Attributes: dropdownmenu.Trigger(ctx)}) {
					@avatar.Avatar(avatar.Props{Size: avatar.SizeSm}) {
						if foto := perfilPhotoURL(inicioUser(data.Me)); foto != "" {
							@avatar.Image(avatar.ImageProps{Src: foto, Alt: "Foto de perfil"})
						}
						@avatar.Fallback() { { inicioUserInitials(data.Me) } }
					}
					<span class="min-w-0 flex-1 text-left"><span class="block truncate text-sm font-medium">{ inicioUserName(data.Me) }</span><span class="block truncate text-xs text-sidebar-foreground/60">Cuenta actual</span></span>
					@icon.ChevronsUpDown(icon.Props{Class: "size-4 shrink-0"})
				}
				@dropdownmenu.Content(dropdownmenu.ContentProps{Class: "w-56"}) {
					@dropdownmenu.Label() { { inicioUserName(data.Me) } }
					@dropdownmenu.Separator()
					@dropdownmenu.Item(dropdownmenu.ItemProps{Attributes: perfilTriggerAttributes(inicioUser(data.Me))}) { @icon.User(icon.Props{Class: "size-4"}) Mi perfil }
					@dropdownmenu.Item(dropdownmenu.ItemProps{Variant: dropdownmenu.ItemVariantDestructive, Attributes: templ.Attributes{"data-on:click": "window.location.href = '/adminx/logout'"}}) { @icon.LogOut(icon.Props{Class: "size-4"}) Cerrar sesión }
				}
			}
		</div>
	</aside>
}

templ InicioContextError(message string) {
	<div id="context-result" class="mt-1 text-right text-xs text-destructive">{ message }</div>
}

templ reloginForm() {
	<form method="post" class="mt-6 space-y-4" data-on:submit__prevent={ "const button = evt.submitter; if (button) { button.disabled = true; button.setAttribute('aria-busy','true'); button.textContent = 'Cargando...'; } @post('/adminx/login?mode=relogin&return_path='+encodeURIComponent(location.pathname)+'&context='+encodeURIComponent($context || ''))" }>
		<div class="space-y-2"><label for="relogin-username" class="text-sm font-medium">Usuario</label><input id="relogin-username" name="username" data-bind:username type="text" autocomplete="username" required class="h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm"/></div>
		<div class="space-y-2"><label for="relogin-password" class="text-sm font-medium">Contraseña</label><input id="relogin-password" name="password" data-bind:password type="password" autocomplete="current-password" required class="h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm"/></div>
		<div id="relogin-result"></div>
		@dialog.Footer() { @button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeButton, Attributes: templ.Attributes{"data-on:click": "window.location.href = '/adminx'"}}) { Salir } @button.Button(button.Props{ID: "relogin-submit", Type: button.TypeSubmit}) { Iniciar sesión } }
	</form>
}
