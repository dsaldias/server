package xlogin

import "github.com/dsaldias/server/data_web/components/button"
import "github.com/dsaldias/server/data_web/components/card"
import "github.com/dsaldias/server/data_web/components/field"
import "github.com/dsaldias/server/data_web/components/input"

templ LoginRender() {
	<div id="page" class="min-h-screen bg-muted/30 px-4 py-8 sm:px-6 lg:px-8">
		<div class="mx-auto grid min-h-[calc(100vh-4rem)] w-full max-w-6xl overflow-hidden rounded-3xl border bg-card shadow-2xl shadow-black/5 lg:grid-cols-[1.05fr_0.95fr]">
			<section class="relative hidden overflow-hidden bg-[#081027] p-10 text-white lg:flex lg:flex-col lg:justify-between xl:p-14">
				<div class="absolute -right-28 -top-28 h-80 w-80 rounded-full border border-white/10"></div>
				<div class="absolute -right-8 top-12 h-48 w-48 rounded-full border border-[#479066]/30"></div>
				<div class="relative">
					<div class="mb-16 flex items-center gap-3">
						<div class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/5">
							<div class="h-2.5 w-2.5 rounded-full bg-[#65c28c] shadow-[0_0_20px_#65c28c]"></div>
						</div>
						<div>
							<p class="text-sm font-semibold tracking-wide">SISTEMA ADMINISTRATIVO</p>
							<p class="text-[10px] uppercase tracking-[0.25em] text-white/40">Acceso seguro</p>
						</div>
					</div>
					<p class="mb-4 text-xs font-medium uppercase tracking-[0.3em] text-[#65c28c]">Control · Gestión · Evolución</p>
					<h1 class="max-w-lg text-4xl font-semibold leading-tight tracking-tight xl:text-5xl">Todo gran recorrido comienza con un acceso.</h1>
					<p class="mt-6 max-w-md text-sm leading-7 text-white/50">Ingresa al entorno administrativo para gestionar las operaciones y continuar con tu trabajo.</p>
				</div>
				<div class="relative flex items-center gap-3 text-xs text-white/30"><div class="h-px w-10 bg-white/10"></div><span>Tu próxima operación comienza aquí</span></div>
			</section>

			<section class="flex items-center justify-center p-6 sm:p-10 lg:p-14">
				@card.Card(card.Props{Class: "w-full max-w-sm border-0 bg-transparent shadow-none"}) {
					@card.Header() {
						<div class="mb-9 flex items-center justify-between lg:hidden">
						<div class="flex items-center gap-2"><div class="flex h-9 w-9 items-center justify-center rounded-lg border bg-muted"><div class="h-2 w-2 rounded-full bg-[#479066]"></div></div><span class="text-xs font-medium text-muted-foreground">Administración</span></div>
						<span class="flex items-center gap-1.5 text-[10px] uppercase tracking-wider text-muted-foreground"><span class="h-1.5 w-1.5 rounded-full bg-[#479066]"></span> Sistema operativo</span>
						</div>
						@card.Title(card.TitleProps{Class: "text-3xl"}) { Inicia sesión }
						@card.Description(card.DescriptionProps{Class: "mt-3 text-sm leading-6"}) { Ingresa tus credenciales para acceder al sistema. }
					}
					@card.Content() {
						<form method="post" class="space-y-5" data-on:submit__prevent={ "@post('/adminx/login')" }>
							@field.Group() {
								@field.Field() {
									@field.Label(field.LabelProps{For: "username"}) { Usuario }
									@input.Input(input.Props{
											ID: "username", Name: "username", Type: "text", Placeholder: "Ingrese su usuario", Required: true, Class: "h-11 rounded-md",
										Attributes: templ.Attributes{"data-bind:username": true},
									})
								}
								@field.Field() {
									<div class="flex items-center justify-between">
										@field.Label(field.LabelProps{For: "password"}) { Contraseña }
										<span class="text-xs text-muted-foreground">Acceso protegido</span>
									</div>
									@input.Input(input.Props{
											ID: "password", Name: "password", Type: "password", Placeholder: "Ingrese su contraseña", Required: true, Class: "h-11 rounded-md",
										Attributes: templ.Attributes{"data-bind:password": true},
									})
								}
								<div id="login-result"></div>
								@button.Button(button.Props{Type: button.TypeSubmit, Class: "h-11 w-full"}) { Ingresar }
							}
						</form>
					}
					@card.Footer() {
						<p class="w-full text-center text-xs text-muted-foreground">El acceso queda protegido mediante una sesión segura.</p>
					}
				}
			</section>
		</div>
	</div>
}

templ LoginError(message string) {
	<div role="alert" class="flex items-start gap-2 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm font-medium text-red-700 shadow-sm dark:border-red-900/50 dark:bg-red-950/40 dark:text-red-300">
		<span class="mt-0.5" aria-hidden="true">⚠</span>
		<span>{ message }</span>
	</div>
}
