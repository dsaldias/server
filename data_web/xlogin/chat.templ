package xlogin

import "github.com/dsaldias/server/data_web/components/avatar"
import "github.com/dsaldias/server/data_web/components/button"
import "github.com/dsaldias/server/data_web/components/dialog"
import "github.com/dsaldias/server/data_web/components/icon"
import "github.com/dsaldias/server/data_web/components/input"
import "github.com/dsaldias/server/graph_auth/model"

templ ChatDialog() {
	@dialog.Dialog(dialog.Props{ID: "chat-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "!bg-card !text-card-foreground shadow-2xl sm:max-w-3xl", Attributes: templ.Attributes{"data-on:auth-v2-chat": chatNotificationHandler()}}) {
			<div id="chat-modal-shell" class="flex h-[min(78vh,42rem)] min-h-0 flex-col gap-3" data-signals:chatConversationID="''" data-signals:chatRecipientID="''" data-signals:chatRecipientName="''" data-signals:chatText="''" data-signals:chatSearch="''" data-signals:chatSending="false">
				<div class="flex items-center gap-2 border-b border-border/60 pb-3 pr-16">
					@button.Button(button.Props{ID: "chat-back-button", Variant: button.VariantGhost, Size: button.SizeIconSm, Class: "hidden", Attributes: templ.Attributes{"data-on:click": chatBackScript()}}) { @icon.ArrowLeft(icon.Props{Class: "size-4"})<span class="sr-only">Volver a conversaciones</span> }
					<div class="min-w-0 flex-1"><h2 id="chat-dialog-title" class="truncate text-base font-semibold">Chat</h2><p class="text-xs text-muted-foreground">Conversaciones privadas</p></div>
					@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Attributes: templ.Attributes{"data-on:click": chatNewScript()}}) { @icon.Plus(icon.Props{Class: "size-4"}) <span class="hidden sm:inline">Nuevo chat</span> }
				</div>
				<div id="chat-error"></div>
				@ChatConversationList(nil)
				<div id="chat-conversation-view" class="hidden min-h-0 flex-1"></div>
				<div id="chat-users-view" class="hidden min-h-0 flex-1 flex-col gap-3">
					<div class="flex gap-2"><div class="relative min-w-0 flex-1">@icon.Search(icon.Props{Class: "pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-muted-foreground"})@input.Input(input.Props{ID: "chat-user-search", Type: "search", Placeholder: "Buscar usuario...", Class: "pl-9", Attributes: templ.Attributes{"data-bind:chatSearch": true, "data-on:input__debounce.300ms": chatSearchRequestScript(), "data-on:keydown": "if(evt.key==='Enter'){" + chatSearchRequestScript() + "}"}})</div>@button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeButton, Attributes: templ.Attributes{"data-on:click": chatSearchRequestScript()}}) { Buscar }</div>
					<div id="chat-users" class="min-h-0 flex-1 overflow-y-auto"></div>
				</div>
			</div>
		}
	}
}

templ ChatConversationList(conversations []*model.ResponseChatConversacion) {
	<div id="chat-conversation-list" class="min-h-0 flex-1 overflow-y-auto">
		if len(conversations) == 0 {
			<div class="flex h-full min-h-48 flex-col items-center justify-center gap-2 rounded-lg border border-dashed border-border/70 p-6 text-center"><div class="flex size-12 items-center justify-center rounded-full bg-muted text-muted-foreground">@icon.MessageCircle(icon.Props{Class: "size-6"})</div><p class="text-sm font-medium">Todavía no tienes conversaciones</p><p class="text-xs text-muted-foreground">Inicia un chat con otro usuario del sistema.</p></div>
		}
		if len(conversations) > 0 {
			<div class="divide-y divide-border/60 rounded-lg border border-border/60">
				for _, conversation := range conversations {
					if conversation != nil {
						<button type="button" class="flex w-full items-center gap-3 p-3 text-left transition-colors hover:bg-muted/60" data-chat-conversation-id={ conversation.ID } data-on:click={ chatConversationClick(conversation.ID) }>
							@avatar.Avatar(avatar.Props{Size: avatar.SizeSm}) {
								if foto := chatConversationPhotoURL(conversation); foto != "" {
									@avatar.Image(avatar.ImageProps{Src: foto, Alt: conversation.Nombre})
								}
								@avatar.Fallback() { { chatInitials(conversation.Nombre) } }
							}
							<span class="min-w-0 flex-1"><span class="flex items-center gap-2"><span class="truncate text-sm font-medium">{ conversation.Nombre }</span>
								if conversation.NoLeidos > 0 {
									<span class="rounded-full bg-primary px-1.5 py-0.5 text-[10px] font-semibold text-primary-foreground">{ chatUnreadString(conversation.NoLeidos) }</span>
								}
							</span><span class="block truncate text-xs text-muted-foreground">{ conversation.UltimoMensaje }</span></span>
							<span class="text-xs text-muted-foreground">{ chatDate(conversation.FechaUpdate) }</span>
						</button>
					}
				}
			</div>
		}
	</div>
}

templ ChatConversationView(conversation *model.ResponseChatConversacion, messages []*model.ChatMensaje, currentUserID string, recipientID string, recipientName string) {
	<div id="chat-conversation-view" class="flex min-h-0 flex-1 flex-col gap-3" data-chat-active data-chat-recipient-id={ recipientID }>
		<div class="flex items-center gap-3 rounded-lg border border-border/60 bg-muted/20 px-3 py-2">@chatConversationAvatar(conversation, recipientName)<div class="min-w-0"><p id="chat-conversation-recipient" class="truncate text-sm font-medium">{ recipientName }</p><p class="text-xs text-muted-foreground">Mensaje privado</p></div></div>
		<div id="chat-messages" class="min-h-0 flex-1 space-y-2 overflow-y-auto rounded-lg border border-border/60 bg-muted/20 p-3">
			if len(messages) == 0 {
				<p class="py-10 text-center text-xs text-muted-foreground">Escribe el primer mensaje.</p>
			}
			if len(messages) > 0 {
				for _, message := range chatMessagesChronological(messages) {
					if message != nil {
						<div class={ chatMessageClass(message, currentUserID) }><p class="whitespace-pre-wrap break-words text-sm">{ message.Texto }</p><p class="mt-1 text-[10px] opacity-70">{ chatDate(message.CreatedAt) }</p></div>
					}
				}
			}
		</div>
		<form class="flex items-end gap-2" data-on:submit__prevent="const input=document.getElementById('chat-message-input');const view=document.getElementById('chat-conversation-view');$chatText=input?.value||'';$chatRecipientID=view?.dataset.chatRecipientId||$chatRecipientID;$chatSending=true;@post('/adminx/chat/send?recipient_id='+encodeURIComponent($chatRecipientID||''))"><textarea id="chat-message-input" class="min-h-10 max-h-28 min-w-0 flex-1 resize-y rounded-lg border border-input bg-background px-3 py-2 text-sm outline-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/30" placeholder="Escribe un mensaje..." maxlength="255" data-bind:chatText required></textarea>@button.Button(button.Props{ID: "chat-send-button", Type: button.TypeSubmit, Size: button.SizeIcon, Attributes: templ.Attributes{"aria-label": "Enviar mensaje"}}) { @icon.Send(icon.Props{Class: "size-4"}) }</form>
	</div>
}

templ chatConversationAvatar(conversation *model.ResponseChatConversacion, recipientName string) {
	@avatar.Avatar(avatar.Props{Size: avatar.SizeSm}) {
		if foto := chatConversationPhotoURL(conversation); foto != "" {
			@avatar.Image(avatar.ImageProps{Src: foto, Alt: recipientName})
		}
		@avatar.Fallback() { { chatInitials(recipientName) } }
	}
}

templ ChatUserList(users []*model.Usuario) {
	<div id="chat-users" class="min-h-0 flex-1 overflow-y-auto">
		if len(users) == 0 {
			<p class="rounded-lg border border-dashed border-border/70 p-6 text-center text-sm text-muted-foreground">No se encontraron usuarios.</p>
		}
		if len(users) > 0 {
			<div class="divide-y divide-border/60 rounded-lg border border-border/60">
				for _, user := range users {
					if user != nil {
						<button type="button" class="flex w-full items-center gap-3 p-3 text-left hover:bg-muted/60" data-on:click={ chatUserClick(user) }>
							@avatar.Avatar(avatar.Props{Size: avatar.SizeSm}) {
								if foto := perfilPhotoURL(user); foto != "" {
									@avatar.Image(avatar.ImageProps{Src: foto, Alt: inicioUserName(&model.ResponseMe{Usuario: user})})
								}
								@avatar.Fallback() { { chatInitials(inicioUserName(&model.ResponseMe{Usuario: user})) } }
							}
							<span class="min-w-0 flex-1"><span class="block truncate text-sm font-medium">{ inicioUserName(&model.ResponseMe{Usuario: user}) }</span><span class="block truncate text-xs text-muted-foreground">Usuario: { user.Username }</span></span>
						</button>
					}
				}
			</div>
		}
	</div>
}

templ ChatError(message string) {
	<div id="chat-error" role="alert" class="rounded-md border border-destructive/30 bg-destructive/10 px-3 py-2 text-sm text-destructive">{ message }</div>
}
