package xlogin

import "github.com/dsaldias/server/data_web/components"
import "github.com/dsaldias/server/data_web/xutility"

// la clave para actualizar en test es cambiar esta variable
// para prod, el propio task build setea el valor en cada compilacion
// por lo general sirve para actualizar los assets como js y css, los html vienen del server

templ MainLayout(
  titulo string,
  config Config,
	AssetVersion string,
){ 
	<!DOCTYPE html>
	<html lang="es">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta id="theme-color" name="theme-color" content={ config.WithDefaults().ThemeColor }/>
			<meta id="x-asset-version" data-value={ AssetVersion }/>
			<title>{ titulo }</title>
			<script>
				if (localStorage.getItem("theme") === "dark") {
					document.documentElement.classList.add("dark");
				}
			</script>
			<link rel="stylesheet" href={ config.WithDefaults().Stylesheet + "?v=" + AssetVersion }/>
			for _, href := range config.ExtraCSS {
				<link rel="stylesheet" href={ href + "?v=" + AssetVersion }/>
			}
			<script type="module" src="https://cdn.jsdelivr.net/gh/starfederation/datastar@v1.0.4/bundles/datastar.js"></script>
			@components.Scripts()
			for _, js := range config.ExtraJS {
				<script src={ js.Src + "?v=" + AssetVersion } if js.Type != "" {
					type={ js.Type }
				}></script>
			}
		</head>
		<body class={ config.WithDefaults().BodyClass }>
			@xutility.NotificationHost()
			{ children... } 
		</body>
	</html>
}

